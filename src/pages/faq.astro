---
// src/pages/faq.astro
import MainLayout from '../layouts/MainLayout.astro';
import { getTranslation, isRTL } from '../utils/i18n.js';

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// FAQ data
const faqCategories = [
  {
    category: "General Questions",
    questions: [
      {
        question: "What is Astrolabe?",
        answer: "Astrolabe is an open-source astrology platform that provides accurate astrological calculations and interpretations. We offer tools for natal charts, transits, synastry, progressions, and more, combining ancient wisdom with modern precision."
      },
      {
        question: "Is Astrolabe free to use?",
        answer: "Yes, Astrolabe offers a free basic plan that includes natal chart generation and basic interpretations. We also offer Pro and Premium plans with additional features for serious astrology enthusiasts and professionals."
      },
      {
        question: "How accurate are your calculations?",
        answer: "Our calculations use the Swiss Ephemeris, one of the most accurate astronomical algorithms available. We account for precession, nutation, and other astronomical factors to provide precise planetary positions. For the most accurate chart, we recommend using your exact birth time and location."
      }
    ]
  },
  {
    category: "Technical Support",
    questions: [
      {
        question: "What browsers does Astrolabe support?",
        answer: "Astrolabe works on all modern browsers including Chrome, Firefox, Safari, and Edge. We recommend using the latest version of your preferred browser for the best experience."
      },
      {
        question: "Can I use Astrolabe on my mobile device?",
        answer: "Yes, Astrolabe is fully responsive and works great on smartphones and tablets. Our mobile experience is optimized for touch interaction and smaller screens."
      },
      {
        question: "How do I report a bug or technical issue?",
        answer: "You can report bugs or technical issues through our contact page or by emailing support@astrolabe.example.com. Please include details about your device, browser, and steps to reproduce the issue."
      }
    ]
  },
  {
    category: "Account & Billing",
    questions: [
      {
        question: "How do I create an account?",
        answer: "You can create an account by clicking the 'Sign Up' button in the top right corner of our website. You'll need to provide your email address and create a password."
      },
      {
        question: "Can I change or cancel my subscription?",
        answer: "Yes, you can upgrade, downgrade, or cancel your subscription at any time from your account settings. Changes take effect immediately, and we offer a 30-day money-back guarantee for all paid plans."
      },
      {
        question: "What payment methods do you accept?",
        answer: "We accept all major credit cards including Visa, Mastercard, and American Express. We also support PayPal and bank transfers for annual subscriptions."
      }
    ]
  },
  {
    category: "Astrology Questions",
    questions: [
      {
        question: "What is a natal chart?",
        answer: "A natal chart, also known as a birth chart, is a map of the sky at the exact moment and location of your birth. It shows the positions of the Sun, Moon, and planets in the zodiac signs and houses, which astrologers use to understand your personality, strengths, challenges, and life path."
      },
      {
        question: "How important is birth time accuracy?",
        answer: "Birth time accuracy is crucial for precise chart calculations, especially for the Ascendant, Moon sign, and house placements. Even a few minutes can make a difference. If you don't know your exact birth time, we can help you rectify it using significant life events."
      },
      {
        question: "Do you offer astrology consultations?",
        answer: "While we don't provide direct consultations, our platform offers detailed interpretations that many professional astrologers use as a foundation for their readings. We also have a community of practitioners who offer consultations."
      }
    ]
  }
];
---

<MainLayout title="Frequently Asked Questions - Astrolabe" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-4">Frequently Asked Questions</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Find answers to common questions about Astrolabe and astrology
        </p>
      </div>
      
      <div x-data="faqAccordion()" class="max-w-4xl mx-auto">
        <template x-for="(category, catIndex) in faqCategories" :key="catIndex">
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700" x-text="category.category"></h2>
            <div class="space-y-6">
              <template x-for="(faq, index) in category.questions" :key="index">
                <div class="bg-white dark:bg-gray-700 rounded-xl shadow-md border border-gray-100 dark:border-gray-600 overflow-hidden">
                  <div @click="toggle(catIndex + '_' + index)" class="faq-question flex justify-between items-center p-6 cursor-pointer">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white" x-text="faq.question"></h3>
                    <svg class="w-5 h-5 text-gray-500 dark:text-gray-300 transform transition-transform duration-200" :class="{ 'rotate-180': openIndex === catIndex + '_' + index }" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <div x-show="openIndex === catIndex + '_' + index" x-transition class="faq-answer px-6 pb-6">
                    <p class="text-gray-600 dark:text-gray-200" x-text="faq.answer"></p>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
      
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 md:p-12 text-white mt-16">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">Still Have Questions?</h2>
          <p class="text-xl text-indigo-100 mb-8">
            Can't find the answer you're looking for? Our support team is here to help.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
              Contact Support
            </a>
            <a href="/community" class="bg-transparent border-2 border-white text-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-colors duration-300">
              Join Community
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <script is:inline>
    function faqAccordion() {
      return {
        openIndex: null,
        toggle(index) {
          if (this.openIndex === index) {
            this.openIndex = null;
          } else {
            this.openIndex = index;
          }
        },
        faqCategories: [
          {
            category: "General Questions",
            questions: [
              {
