---
// src/pages/blog/[id].astro
import MainLayout from '../../layouts/MainLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getTranslation, isRTL } from '../../utils/i18n.js';
import { englishBlogPosts as blogPosts } from '../../utils/blogData.js';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { id: post.id },
  }));
}

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Get the post ID from the URL
const { id } = Astro.params;

// Find the specific blog post
const post = blogPosts.find(p => p.id === id) || blogPosts[0];

// Find related posts (same category, excluding current post)
const relatedPosts = blogPosts.filter(p => p.category === post.category && p.id !== id).slice(0, 2);
---

&lt;MainLayout title={`${post.title} - Astrolabe`} lang={lang} dir={dir}&gt;
  &lt;section class="py-8"&gt;
    &lt;div class="container mx-auto px-4"&gt;
      &lt;div class="grid grid-cols-1 lg:grid-cols-3 gap-8"&gt;
        &lt;!-- Main Content --&gt;
        &lt;div class="lg:col-span-2"&gt;
          &lt;article class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700"&gt;
            &lt;!-- Featured Image --&gt;
            &lt;div class="w-full overflow-hidden"&gt;
              &lt;img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-auto object-cover"
              /&gt;
            &lt;/div&gt;
            
            &lt;div class="p-8"&gt;
              &lt;div class="flex flex-wrap items-center justify-between gap-4 mb-6"&gt;
                &lt;div class="flex items-center"&gt;
                  &lt;span class="text-sm font-medium text-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 dark:text-indigo-300 px-3 py-1 rounded-full"&gt;{post.category}&lt;/span&gt;
                  {post.featured &amp;&amp; (
                    &lt;span class="px-3 py-1 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-bold rounded-full ml-2"&gt;Featured&lt;/span&gt;
                  )}
                &lt;/div&gt;
                &lt;div class="flex items-center"&gt;
                  &lt;div class="w-10 h-10 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mr-3"&gt;
                    &lt;span class="text-sm font-bold text-white"&gt;{post.author.charAt(0)}&lt;/span&gt;
                  &lt;/div&gt;
                  &lt;div&gt;
                    &lt;p class="font-medium text-gray-900 dark:text-white"&gt;{post.author}&lt;/p&gt;
                    &lt;p class="text-sm text-gray-500 dark:text-gray-400"&gt;{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} · {post.readTime}&lt;/p&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              
              &lt;h1 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 dark:text-white mb-6"&gt;{post.title}&lt;/h1&gt;
              
              &lt;div class="prose prose-lg max-w-none dark:prose-invert"&gt;
                &lt;div set:html={post.content} /&gt;
              &lt;/div&gt;
              
              &lt;!-- Tags --&gt;
              &lt;div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700"&gt;
                &lt;div class="flex flex-wrap gap-2"&gt;
                  &lt;span class="text-sm font-medium text-gray-700 dark:text-gray-300"&gt;Tags:&lt;/span&gt;
                  &lt;a href="#" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 rounded-full"&gt;Astrology&lt;/a&gt;
                  &lt;a href="#" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 rounded-full"&gt;Zodiac&lt;/a&gt;
                  &lt;a href="#" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 rounded-full"&gt;Personal Growth&lt;/a&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              
              &lt;!-- Share Buttons --&gt;
              &lt;div class="flex flex-wrap items-center justify-between mt-8 pt-6 border-t border-gray-200 dark:border-gray-700"&gt;
                &lt;div&gt;
                  &lt;p class="text-lg font-medium text-gray-900 dark:text-white mb-2"&gt;Share this article&lt;/p&gt;
                  &lt;div class="flex space-x-2"&gt;
                    &lt;a href="#" class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-gray-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-gray-600 transition-colors duration-200"&gt;
                      &lt;svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"&gt;
                        &lt;path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/&gt;
                      &lt;/svg&gt;
                    &lt;/a&gt;
                    &lt;a href="#" class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-gray-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-gray-600 transition-colors duration-200"&gt;
                      &lt;svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"&gt;
                        &lt;path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/&gt;
                      &lt;/svg&gt;
                    &lt;/a&gt;
                    &lt;a href="#" class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-gray-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-gray-600 transition-colors duration-200"&gt;
                      &lt;svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"&gt;
                        &lt;path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.093c.872-1.616 4-1.736 4 1.548v6.759z"/&gt;
                      &lt;/svg&gt;
                    &lt;/a&gt;
                    &lt;a href="#" class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-gray-700 flex items-center justify-center text-indigo-600 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-gray-600 transition-colors duration-200"&gt;
                      &lt;svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"&gt;
                        &lt;path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2 16h-2v-6h2v6zm-1-6.891c-.607 0-1.1-.496-1.1-1.109 0-.612.492-1.109 1.1-1.109s1.1.497 1.1 1.109c0 .613-.493 1.109-1.1 1.109zm8 6.891h-1.998v-2.861c0-1.881-2.002-1.722-2.002 0v2.861h-2v-6h2v1.093c.872-1.616 4-1.736 4 1.548v3.359z"/&gt;
                      &lt;/svg&gt;
                    &lt;/a&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
                
                &lt;a href="/blog" class="inline-flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 font-medium transition-colors duration-200 mt-4 md:mt-0"&gt;
                  &lt;svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"&gt;
                    &lt;path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"&gt;&lt;/path&gt;
                  &lt;/svg&gt;
                  Back to Blog
                &lt;/a&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/article&gt;
          
          &lt;!-- Author Bio --&gt;
          &lt;div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 mt-8 border border-gray-100 dark:border-gray-700"&gt;
            &lt;div class="flex items-start"&gt;
              &lt;div class="w-16 h-16 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mr-6 flex-shrink-0"&gt;
                &lt;span class="text-xl font-bold text-white"&gt;{post.author.charAt(0)}&lt;/span&gt;
              &lt;/div&gt;
              &lt;div&gt;
                &lt;h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2"&gt;About {post.author}&lt;/h3&gt;
                &lt;p class="text-gray-600 dark:text-gray-300 mb-4"&gt;
                  Professional astrologer with over 10 years of experience in natal chart interpretation and predictive astrology. 
                  Passionate about making astrology accessible to everyone through clear explanations and practical applications.
                &lt;/p&gt;
                &lt;div class="flex space-x-4"&gt;
                  &lt;a href="#" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 text-sm font-medium"&gt;View Profile&lt;/a&gt;
                  &lt;a href="#" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 text-sm font-medium"&gt;More Articles&lt;/a&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;
          
          &lt;!-- Related Posts --&gt;
          {relatedPosts.length &gt; 0 &amp;&amp; (
            &lt;div class="mt-12"&gt;
              &lt;h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6"&gt;Related Articles&lt;/h2&gt;
              &lt;div class="grid grid-cols-1 md:grid-cols-2 gap-6"&gt;
                {relatedPosts.map(relatedPost =&gt; (
                  &lt;a href={`/blog/${relatedPost.id}`} class="block bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-lg transition-shadow duration-300"&gt;
                    &lt;div class="p-6"&gt;
                      &lt;div class="flex items-center mb-3"&gt;
                        &lt;span class="text-xs font-medium text-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 dark:text-indigo-300 px-2 py-1 rounded-full"&gt;{relatedPost.category}&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2"&gt;{relatedPost.title}&lt;/h3&gt;
                      &lt;p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2"&gt;{relatedPost.excerpt}&lt;/p&gt;
                      &lt;div class="flex items-center text-sm text-gray-500 dark:text-gray-400"&gt;
                        &lt;span&gt;{new Date(relatedPost.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}&lt;/span&gt;
                        &lt;span class="mx-2"&gt;·&lt;/span&gt;
                        &lt;span&gt;{relatedPost.readTime}&lt;/span&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                  &lt;/a&gt;
                ))}
              &lt;/div&gt;
            &lt;/div&gt;
          )}
          
          &lt;!-- Newsletter Signup --&gt;
          &lt;div class="mt-12"&gt;
            &lt;NewsletterSignup lang={lang} /&gt;
          &lt;/div&gt;
        &lt;/div&gt;
        
        &lt;!-- Sidebar --&gt;
        &lt;div class="lg:col-span-1"&gt;
          &lt;div class="sticky top-8 space-y-8"&gt;
            &lt;!-- Popular Posts --&gt;
            &lt;div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700"&gt;
              &lt;h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4"&gt;Popular Posts&lt;/h3&gt;
              &lt;div class="space-y-4"&gt;
                {blogPosts.slice(0, 3).map(popularPost =&gt; (
                  &lt;a href={`/blog/${popularPost.id}`} class="flex group"&gt;
                    &lt;div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden mr-4"&gt;
                      &lt;img src={popularPost.image} alt={popularPost.title} class="w-full h-full object-cover" /&gt;
                    &lt;/div&gt;
                    &lt;div&gt;
                      &lt;h4 class="text-sm font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 mb-1 line-clamp-2"&gt;{popularPost.title}&lt;/h4&gt;
                      &lt;p class="text-xs text-gray-500 dark:text-gray-400"&gt;{new Date(popularPost.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}&lt;/p&gt;
                    &lt;/div&gt;
                  &lt;/a&gt;
                ))}
              &lt;/div&gt;
            &lt;/div&gt;
            
            &lt;!-- Categories --&gt;
            &lt;div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700"&gt;
              &lt;h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4"&gt;Categories&lt;/h3&gt;
              &lt;div class="space-y-2"&gt;
                &lt;a href="#" class="flex justify-between items-center py-2 text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400"&gt;
                  &lt;span&gt;Zodiac Signs&lt;/span&gt;
                  &lt;span class="bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-medium px-2 py-0.5 rounded-full"&gt;12&lt;/span&gt;
                &lt;/a&gt;
                &lt;a href="#" class="flex justify-between items-center py-2 text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400"&gt;
                  &lt;span&gt;Planetary Movements&lt;/span&gt;
                  &lt;span class="bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-medium px-2 py-0.5 rounded-full"&gt;8&lt;/span&gt;
                &lt;/a&gt;
                &lt;a href="#" class="flex justify-between items-center py-2 text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400"&gt;
                  &lt;span&gt;Natal Charts&lt;/span&gt;
                  &lt;span class="bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-medium px-2 py-0.5 rounded-full"&gt;15&lt;/span&gt;
                &lt;/a&gt;
                &lt;a href="#" class="flex justify-between items-center py-2 text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400"&gt;
                  &lt;span&gt;Relationships&lt;/span&gt;
                  &lt;span class="bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-medium px-2 py-0.5 rounded-full"&gt;7&lt;/span&gt;
                &lt;/a&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/section&gt;
&lt;/MainLayout&gt;