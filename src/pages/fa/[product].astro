---
// src/pages/fa/[product].astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';
import { Image } from 'astro:assets';
import { products } from '@utils/products.js';

// Import all images
import image1 from '@public/images/1.jpg';
import image2 from '@public/images/2.jpg';
import image3 from '@public/images/3.jpg';
import image4 from '@public/images/4.jpg';
import image5 from '@public/images/5.jpg';
import image6 from '@public/images/6.png';
import image7 from '@public/images/7.jpg';
import image8 from '@public/images/8.jpg';
import image9 from '@public/images/9.jpg';
import image10 from '@public/images/10.jpg';
import image11 from '@public/images/11.jpg';
import image12 from '@public/images/12.jpg';
import image13 from '@public/images/13.jpg';
import image14 from '@public/images/14.jpg';
import image15 from '@public/images/15.jpg';
import image16 from '@public/images/16.jpg';
import image17 from '@public/images/17.jpg';
import image18 from '@public/images/18.jpg';
import image19 from '@public/images/19.jpg';

// Map image names to imports
const imageMap = {
  '1.jpg': image1,
  '2.jpg': image2,
  '3.jpg': image3,
  '4.jpg': image4,
  '5.jpg': image5,
  '6.png': image6,
  '7.jpg': image7,
  '8.jpg': image8,
  '9.jpg': image9,
  '10.jpg': image10,
  '11.jpg': image11,
  '12.jpg': image12,
  '13.jpg': image13,
  '14.jpg': image14,
  '15.jpg': image15,
  '16.jpg': image16,
  '17.jpg': image17,
  '18.jpg': image18,
  '19.jpg': image19
};

// Required for static generation of dynamic routes
export function getStaticPaths() {
  const productSlugs = Object.keys(products.fa);
  return productSlugs.map(slug => ({
    params: { product: slug },
  }));
}

const { product } = Astro.params;
const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Get product data
const productData = products[lang][product];

// If product doesn't exist, return 404
if (!productData) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const {
  title,
  name,
  description,
  emoji,
  image,
  color,
  about,
  benefits,
  features
} = productData;

// Color mapping for Tailwind classes
const colorClasses = {
  blue: {
    primary: 'bg-blue-100 dark:bg-blue-900/30',
    secondary: 'bg-blue-50 dark:bg-blue-900/20',
    text: 'text-blue-600 dark:text-blue-400',
    title: 'text-blue-800 dark:text-blue-200',
    description: 'text-blue-700 dark:text-blue-300',
    gradientFrom: 'from-blue-50',
    gradientTo: 'to-indigo-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-blue-600 hover:bg-blue-700',
    border: 'border-blue-600',
    chart: 'from-blue-400 to-indigo-500'
  },
  purple: {
    primary: 'bg-purple-100 dark:bg-purple-900/30',
    secondary: 'bg-purple-50 dark:bg-purple-900/20',
    text: 'text-purple-600 dark:text-purple-400',
    title: 'text-purple-800 dark:text-purple-200',
    description: 'text-purple-700 dark:text-purple-300',
    gradientFrom: 'from-purple-50',
    gradientTo: 'to-pink-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-purple-600 hover:bg-purple-700',
    border: 'border-purple-600',
    chart: 'from-purple-400 to-pink-500'
  },
  pink: {
    primary: 'bg-pink-100 dark:bg-pink-900/30',
    secondary: 'bg-pink-50 dark:bg-pink-900/20',
    text: 'text-pink-600 dark:text-pink-400',
    title: 'text-pink-800 dark:text-pink-200',
    description: 'text-pink-700 dark:text-pink-300',
    gradientFrom: 'from-pink-50',
    gradientTo: 'to-rose-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-pink-600 hover:bg-pink-700',
    border: 'border-pink-600',
    chart: 'from-pink-400 to-rose-500'
  },
  green: {
    primary: 'bg-green-100 dark:bg-green-900/30',
    secondary: 'bg-green-50 dark:bg-green-900/20',
    text: 'text-green-600 dark:text-green-400',
    title: 'text-green-800 dark:text-green-200',
    description: 'text-green-700 dark:text-green-300',
    gradientFrom: 'from-green-50',
    gradientTo: 'to-emerald-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-green-600 hover:bg-green-700',
    border: 'border-green-600',
    chart: 'from-green-400 to-emerald-500'
  },
  yellow: {
    primary: 'bg-yellow-100 dark:bg-yellow-900/30',
    secondary: 'bg-yellow-50 dark:bg-yellow-900/20',
    text: 'text-yellow-600 dark:text-yellow-400',
    title: 'text-yellow-800 dark:text-yellow-200',
    description: 'text-yellow-700 dark:text-yellow-300',
    gradientFrom: 'from-yellow-50',
    gradientTo: 'to-amber-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-yellow-600 hover:bg-yellow-700',
    border: 'border-yellow-600',
    chart: 'from-yellow-400 to-amber-500'
  },
  red: {
    primary: 'bg-red-100 dark:bg-red-900/30',
    secondary: 'bg-red-50 dark:bg-red-900/20',
    text: 'text-red-600 dark:text-red-400',
    title: 'text-red-800 dark:text-red-200',
    description: 'text-red-700 dark:text-red-300',
    gradientFrom: 'from-red-50',
    gradientTo: 'to-orange-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-red-600 hover:bg-red-700',
    border: 'border-red-600',
    chart: 'from-red-400 to-orange-500'
  },
  teal: {
    primary: 'bg-teal-100 dark:bg-teal-900/30',
    secondary: 'bg-teal-50 dark:bg-teal-900/20',
    text: 'text-teal-600 dark:text-teal-400',
    title: 'text-teal-800 dark:text-teal-200',
    description: 'text-teal-700 dark:text-teal-300',
    gradientFrom: 'from-teal-50',
    gradientTo: 'to-cyan-50',
    gradientDark: 'dark:from-gray-800 dark:to-gray-800',
    button: 'bg-teal-600 hover:bg-teal-700',
    border: 'border-teal-600',
    chart: 'from-teal-400 to-cyan-500'
  }
};

const colors = colorClasses[color] || colorClasses.blue;

// Additional data for enhanced product pages
const testimonials = [
  {
    name: "سارا محمدی",
    role: "مدیر محصول",
    content: "این راهکار چگونگی کار تیم ما با چالش‌ها را دگرگون کرد. نتایج فوری و تأثیرگذار بود.",
    avatar: "س"
  },
  {
    name: "محمد رضایی",
    role: "مدیر فناوری اطلاعات",
    content: "اجرای آسان و بازده سرمایه‌گذاری آشکار در سه ماه اول. به شدت توصیه می‌کنم.",
    avatar: "م"
  },
  {
    name: "زهرا احمدی",
    role: "طراح تجربه کاربری",
    content: "رابط کاربری شهودی و ویژگی‌های قدرتمند آن را به ابزاری جداناشدنی برای گردش کار ما تبدیل کرده است.",
    avatar: "ز"
  }
];

const stats = [
  { value: "۹۸٪", label: "رضایت کاربران" },
  { value: "۲.۵ برابر", label: "بازده سرمایه‌گذاری متوسط" },
  { value: "۵۰۰+", label: "مشتریان سازمانی" },
  { value: "۲۴/۷", label: "پشتیبانی در دسترس" }
];

// Data for enhanced sections
const useCases = [
  {
    title: "رشد شخصی",
    description: "خودآگاهی را افزایش دهید و پتانسیل خود را با بینش‌های شخصی‌سازی شده باز کنید.",
    icon: "🧠"
  },
  {
    title: "پیشرفت حرفه‌ای",
    description: "رشد شغلی خود را با ابزارهایی که برای بهبود روابط و عملکرد کاری طراحی شده‌اند، تسریع کنید.",
    icon: "💼"
  },
  {
    title: "ایجاد رابطه",
    description: "ارتباطات شخصی را از طریق درک عمیق‌تر از سبک‌های ارتباطی و نیازهای عاطفی تقویت کنید.",
    icon: "❤️"
  },
  {
    title: "مدیریت استرس",
    description: "استراتژی‌های مقابله‌ای مؤثر را توسعه دهید تا با مقاومت و اعتماد به نفس، چالش‌های زندگی را مدیریت کنید.",
    icon: "🧘"
  },
  {
    title: "تصمیم‌گیری",
    description: "در تصمیمات مهم با بینش‌های مبتنی بر داده که با ارزش‌ها و اهدافتان هم‌راستا هستند، وضوح حاصل کنید.",
    icon: "🎯"
  },
  {
    title: "بیان خلاقانه",
    description: "از طریق درک روان‌شناختی، موانع خلاقیت را برطرف کنید و سطوح جدیدی از نوآوری را باز کنید.",
    icon: "🎨"
  }
];

const techFeatures = [
  {
    title: "الگوریتم‌های پیشرفته هوش مصنوعی",
    description: "مدل‌های یادگیری ماشین پیشرفته که به‌طور مستمر با نیازهای در حال تکامل شما سازگار می‌شوند.",
    icon: "🤖"
  },
  {
    title: "تحلیل‌های لحظه‌ای",
    description: "بینش‌ها و توصیه‌های فوری بر اساس آخرین تعاملات و الگوهای رفتاری شما.",
    icon: "📊"
  },
  {
    title: "حریم خصوصی در اولویت",
    description: "رمزگذاری درجه نظامی و کنترل‌های سختگیرانه حریم خصوصی برای محافظت از اطلاعات حساس شما.",
    icon: "🔒"
  },
  {
    title: "همگام‌سازی بین پلتفرم‌ها",
    description: "دسترسی یکپارچه به بینش‌ها و پیشرفت‌های خود در تمام دستگاه‌هایتان با همگام‌سازی خودکار.",
    icon: "🔄"
  }
];
---

<MainLayout title={title} lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <!-- Hero Section -->
      <div class="text-center mb-16 relative">
        <div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-gradient-to-r from-purple-400 via-pink-500 to-red-500 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob"></div>
        <div class="absolute top-0 left-1/3 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-gradient-to-r from-blue-400 via-green-500 to-teal-500 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob animation-delay-2000"></div>
        <div class="absolute top-0 right-1/3 transform translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob animation-delay-4000"></div>
        
        <div class="relative z-10">
          <div class="flex justify-center mb-6">
            <div class={`w-24 h-24 rounded-full ${colors.primary} flex items-center justify-center shadow-xl`}>
              <span class="text-4xl">{emoji}</span>
            </div>
          </div>
          <h1 class="text-4xl md:text-6xl font-serif font-bold text-gray-900 dark:text-white mb-6">{name}</h1>
          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-8">
            {description}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://panel.zehna.ir" class={`bg-${color}-600 hover:bg-${color}-700 text-white font-medium px-8 py-3 rounded-lg transition-all duration-300 shadow-lg transform hover:scale-105 inline-flex items-center justify-center`}>
              شروع کنید
            </a>
            <button class="bg-transparent border-2 border-gray-300 dark:border-gray-600 text-gray-800 dark:text-white font-medium px-8 py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-300 transform hover:scale-105">
              برنامه‌ریزی نمایش
            </button>
          </div>
        </div>
      </div>

      <!-- Stats Section -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        {
          stats.map((stat, index) => (
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 text-center border border-gray-100 dark:border-gray-700 transform transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
              <div class={`text-3xl font-bold ${colors.text} mb-2`}>{stat.value}</div>
              <div class="text-gray-600 dark:text-gray-400">{stat.label}</div>
            </div>
          ))
        }
      </div>

      <!-- Overview Section -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <div class="relative">
          <div class="absolute -top-4 -left-4 w-32 h-32 bg-gradient-to-r from-blue-400 to-purple-500 rounded-full mix-blend-multiply filter blur-xl opacity-30"></div>
          <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-gradient-to-r from-purple-400 to-pink-500 rounded-full mix-blend-multiply filter blur-xl opacity-30"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-xl mb-8 transform transition-all duration-500 hover:shadow-2xl">
            <Image 
              src={imageMap[image]} 
              alt={name} 
              class="w-full h-auto object-cover"
              width={800} 
              height={500}
              format="webp"
              loading="lazy"
            />
          </div>
        </div>
        <div>
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-100 dark:border-gray-700 h-full transform transition-all duration-300 hover:shadow-xl">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">درباره {name}</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              {about}
            </p>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              چه در حال شروع به کاوش این راهکار هستید یا به دنبال عمیق‌تر کردن مشارکت خود هستید، 
              {name} بینش‌های شخصی‌سازی شده و راه حل‌های مبتنی بر شواهد را برای راهنمایی شما در هر مرحله از مسیر فراهم می‌کند.
            </p>
            
            <div class={`mt-8 p-6 ${colors.secondary} rounded-xl border-r-4 ${colors.border}`}>
              <h3 class={`font-bold ${colors.title} mb-3 text-lg`}>مزایای کلیدی</h3>
              <p class={`${colors.description}`}>
                {benefits}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Use Cases Section -->
      <div class="mb-16">
        <h2 class="text-3xl font-serif font-bold text-center text-gray-900 dark:text-white mb-4">کاربردهای دگرگون‌کننده</h2>
        <p class="text-center text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-12">
          کشف کنید که چگونه {name} می‌تواند جنبه‌های مختلف زندگی و کار شما را ارتقا دهد
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            useCases.map((useCase, index) => (
              <div class={`bg-gradient-to-br ${index % 2 === 0 ? 'from-white to-gray-50' : 'from-gray-50 to-white'} dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 transform transition-all duration-300 hover:shadow-xl hover:-translate-y-2`}>
                <div class={`text-4xl mb-4 text-center ${colors.text}`}>{useCase.icon}</div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 text-center">{useCase.title}</h3>
                <p class="text-gray-600 dark:text-gray-300 text-center">
                  {useCase.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Features Section with Creative Layout -->
      <div class={`bg-gradient-to-r ${colors.gradientFrom} ${colors.gradientTo} ${colors.gradientDark} rounded-2xl p-8 mb-16`}>
        <h2 class="text-3xl font-serif font-bold text-center text-gray-900 dark:text-white mb-4">توانایی‌های اصلی</h2>
        <p class="text-center text-gray-700 dark:text-gray-300 max-w-3xl mx-auto mb-12">
          ویژگی‌های پیشرفته طراحی شده برای دگرگونی رویکرد شما و ارائه نتایج قابل اندازه‌گیری
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            features.map((feature, index) => (
              <div class={`bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 transform transition-all duration-300 hover:shadow-xl ${index % 3 === 0 ? 'hover:rotate-1' : index % 3 === 1 ? 'hover:-rotate-1' : 'hover:rotate-0'}`}>
                <div class="flex items-start mb-4">
                  <div class={`w-12 h-12 rounded-lg ${colors.primary} flex items-center justify-center mr-4 flex-shrink-0`}>
                    <svg class={`w-6 h-6 ${colors.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white">{feature.title}</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-300">
                  {feature.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Technology Features with Unique Card Design -->
      <div class="mb-16">
        <h2 class="text-3xl font-serif font-bold text-center text-gray-900 dark:text-white mb-4">فناوری پیشرفته</h2>
        <p class="text-center text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-12">
          ویژگی‌های پیشرفته که راه‌حل‌های هوشمند ما را قدرت می‌دهد
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            techFeatures.map((feature, index) => (
              <div class={`relative bg-gradient-to-br ${index % 2 === 0 ? 'from-white to-gray-50' : 'from-gray-50 to-white'} dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 overflow-hidden transform transition-all duration-500 hover:shadow-xl`}>
                <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-r from-blue-400 to-purple-500 rounded-full mix-blend-multiply filter blur-2xl opacity-10"></div>
                <div class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-r from-purple-400 to-pink-500 rounded-full mix-blend-multiply filter blur-2xl opacity-10"></div>
                <div class="relative z-10">
                  <div class="text-4xl mb-4 text-center">{feature.icon}</div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 text-center">{feature.title}</h3>
                  <p class="text-gray-600 dark:text-gray-300 text-center">
                    {feature.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- How It Works Section with Timeline Design -->
      <div class="mb-16">
        <h2 class="text-3xl font-serif font-bold text-center text-gray-900 dark:text-white mb-4">نحوه کار {name}</h2>
        <p class="text-center text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-12">
          فرآیند ساده شده طراحی شده برای حداکثر تأثیر و حداقل پیچیدگی
        </p>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gradient-to-b from-blue-500 to-purple-500 rounded-full"></div>
          
          <div class="space-y-12">
            <div class="relative flex items-start">
              <div class="w-1/2 pr-8 text-right">
                <div class={`w-16 h-16 rounded-full ${colors.primary} flex items-center justify-center mx-auto shadow-lg`} style="margin-bottom: 0;">
                  <span class="text-2xl font-bold text-gray-900 dark:text-white">۱</span>
                </div>
              </div>
              <div class="w-1/2 pl-8 mr-10">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">ایجاد پروفایل</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  تکمیل ارزیابی جامع برای ساختن پروفایل روان‌شناختی و اهداف رابطه‌ای شما.
                </p>
              </div>
            </div>
            
            <div class="relative flex items-start">
              <div class="w-1/2 pl-8 text-left">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">تحلیل سازگاری</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  هوش مصنوعی ما سازگاری روان‌شناختی شما با شرکای بالقوه را با استفاده از الگوریتم‌های پیشرفته تحلیل می‌کند.
                </p>
              </div>
              <div class="w-1/2 pr-8 text-right">
                <div class={`w-16 h-16 rounded-full ${colors.primary} flex items-center justify-center mx-auto shadow-lg`} style="margin-bottom: 0;">
                  <span class="text-2xl font-bold text-gray-900 dark:text-white">۲</span>
                </div>
              </div>
            </div>
            
            <div class="relative flex items-start">
              <div class="w-1/2 pr-8 text-right">
                <div class={`w-16 h-16 rounded-full ${colors.primary} flex items-center justify-center mx-auto shadow-lg`} style="margin-bottom: 0;">
                  <span class="text-2xl font-bold text-gray-900 dark:text-white">۳</span>
                </div>
              </div>
              <div class="w-1/2 pl-8 mr-10">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">تطبیق شخصی‌سازی شده</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  دریافت تطبیق‌های انتخاب شده بر اساس سازگاری روان‌شناختی به جای ویژگی‌های سطحی.
                </p>
              </div>
            </div>
            
            <div class="relative flex items-start">
              <div class="w-1/2 pl-8 text-left">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">راهنمایی رابطه</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  دسترسی به مشاوره‌ها و ابزارهای شخصی‌سازی شده برای تقویت رابطه در هر مرحله.
                </p>
              </div>
              <div class="w-1/2 pr-8 text-right">
                <div class={`w-16 h-16 rounded-full ${colors.primary} flex items-center justify-center mx-auto shadow-lg`} style="margin-bottom: 0;">
                  <span class="text-2xl font-bold text-gray-900 dark:text-white">۴</span>
                </div>
              </div>
            </div>
            
            <div class="relative flex items-start">
              <div class="w-1/2 pr-8 text-right">
                <div class={`w-16 h-16 rounded-full ${colors.primary} flex items-center justify-center mx-auto shadow-lg`} style="margin-bottom: 0;">
                  <span class="text-2xl font-bold text-gray-900 dark:text-white">۵</span>
                </div>
              </div>
              <div class="w-1/2 pl-8 mr-10">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">حمایت مستمر</h3>
                <p class="text-gray-600 dark:text-gray-400">
                  پایش مستمر و تنظیم توصیه‌ها بر اساس دینامیک‌های در حال تکامل رابطه شما.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Testimonials Section with Carousel Design -->
      <div class="mb-16">
        <h2 class="text-3xl font-serif font-bold text-center text-gray-900 dark:text-white mb-4">نظرات کاربران ما</h2>
        <p class="text-center text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-12">
          تجربه‌های واقعی از متخصصانی که رویکرد خود را دگرگون کرده‌اند
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            testimonials.map((testimonial, index) => (
              <div class={`bg-gradient-to-br ${index % 2 === 0 ? 'from-white to-gray-50' : 'from-gray-50 to-white'} dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 transform transition-all duration-300 hover:shadow-xl`}>
                <div class="flex items-center mb-4">
                  <div class={`w-16 h-16 rounded-full flex items-center justify-center mr-4 overflow-hidden ${colors.primary}`}>
                    <span class="font-bold text-2xl text-gray-900 dark:text-white">{testimonial.avatar}</span>
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900 dark:text-white">{testimonial.name}</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-400">{testimonial.role}</p>
                  </div>
                </div>
                <p class="text-gray-700 dark:text-gray-300 italic">
                  "{testimonial.content}"
                </p>
                <div class="flex mt-4">
                  {[...Array(5)].map((_, i) => (
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- CTA Section with Gradient Overlay -->
      <div class={`bg-gradient-to-r from-${color}-600 to-${color}-700 rounded-2xl p-8 md:p-12 light:text-black dark:text-white mb-16 relative overflow-hidden`}>
        <div class="absolute top-0 left-0 w-full h-full bg-[url('/images/pattern.svg')] opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">سفر روانی خود را دگرگون کنید</h2>
          <p class="text-xl light:text-black dark:text-white mb-8">
            به هزاران نفری که با راه‌حل‌های هوشمند ما وضعیت خود را بهتر کرده‌اند بپیوندید.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button class="bg-white text-gray-900 font-medium px-8 py-3 rounded-lg hover:bg-gray-100 transition-all duration-300 shadow-lg transform hover:scale-105 light:text-black dark:text-white">
              شروع سفر شما
            </button>
            <button class="bg-transparent border-2 border-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-all duration-300 transform hover:scale-105 light:text-black dark:text-white">
              صحبت با متخصصان 
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>