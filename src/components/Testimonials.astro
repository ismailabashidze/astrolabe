---
// src/components/Testimonials.astro
// Accept locale as a prop
const { locale = "en" } = Astro.props;

let t;
if (locale === 'fa') {
  const module = await import('@i18n/fa.json');
  t = module.default;
} else {
  // Default to English
  const module = await import('@i18n/en.json');
  t = module.default;
}

// Function to extract testimonials from the translation object
const extractTestimonials = (testimonialObj) => {
  const testimonials = [];
  // Iterate through the testimonial properties
  for (let i = 1; i <= 12; i++) {
    const key = `testimonial${i}`;
    if (testimonialObj[key]) {
      testimonials.push({
        id: i,
        name: testimonialObj[key].name,
        role: testimonialObj[key].role,
        quote: testimonialObj[key].quote,
        avatar: `/images/${i}.jpg`,
        bgColor: i % 3 === 1 
          ? "bg-indigo-100 dark:bg-indigo-900/30" 
          : i % 3 === 2 
            ? "bg-purple-100 dark:bg-purple-900/30" 
            : "bg-pink-100 dark:bg-pink-900/30"
      });
    }
  }
  // Return only the first 3 testimonials for display
  return testimonials.slice(0, 3);
};

// Extract testimonials based on locale
const testimonials = extractTestimonials(t.testimonials);
---

<section class="my-20">
  <div class="text-center mb-16">
    <div class="flex items-center justify-center mb-8">
      <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mr-3">
        <img src="/images/logo.svg" alt="Zehna Logo" class="w-12 h-12" />
      </div>
      <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">{t.testimonials.title}</h2>
    </div>
    <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
      {t.testimonials.subtitle}
    </p>
  </div>
  
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
    {testimonials.map((testimonial) => (
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-shadow duration-300">
        <div class="flex items-center mb-4">
          <div class={`w-16 h-16 rounded-full flex items-center justify-center mr-4 overflow-hidden ${testimonial.bgColor}`}>
            <img 
              src={testimonial.avatar} 
              alt={testimonial.name} 
              class="w-full h-full object-cover"
              width="100" 
              height="100"
            />
          </div>
          <div>
            <h4 class="font-bold text-gray-900 dark:text-white">{testimonial.name}</h4>
            <p class="text-sm text-gray-500 dark:text-gray-400">{testimonial.role}</p>
          </div>
        </div>
        <p class="text-gray-700 dark:text-gray-300 italic">{testimonial.quote}</p>
        <div class="flex mt-4">
          {[...Array(5)].map((_, i) => (
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
            </svg>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
<script is:inline>
  function testimonialCarousel({ groupedTestimonials }) {
    return {
      currentIndex: 0,
      interval: null,
      groupedTestimonials: groupedTestimonials,
      init() {
        // Auto-advance testimonials every 5 seconds
        this.interval = setInterval(() => {
          this.next();
        }, 5000);
        
        // Pause auto-advance when user hovers over the carousel
        this.$el.addEventListener('mouseenter', () => {
          clearInterval(this.interval);
        });
        
        // Resume auto-advance when user stops hovering
        this.$el.addEventListener('mouseleave', () => {
          this.interval = setInterval(() => {
            this.next();
          }, 5000);
        });
      },
      next() {
        this.currentIndex = (this.currentIndex + 1) % this.groupedTestimonials.length;
      },
      prev() {
        this.currentIndex = (this.currentIndex - 1 + this.groupedTestimonials.length) % this.groupedTestimonials.length;
      },
      goToSlide(index) {
        this.currentIndex = index;
      }
    }
  }
</script>