                </a>
              </div>
            </div>
          </nav>
          
          <!-- Desktop Language Switcher -->
          <div class="hidden md:flex items-center space-x-4">
            <ThemeSwitcher />
            <LanguageSelector currentLang={lang} lang={lang} dir={dir} />
            
            <button class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-4 py-2 rounded-lg font-medium hover:from-indigo-700 hover:to-purple-700 transition-all duration-200 shadow-md hover:shadow-lg">
              {t('signUp')}
            </button>
          </div>
          
          <!-- Mobile Menu Button -->
          <button id="mobile-menu-button" class="md:hidden text-gray-700 p-2 rounded-lg hover:bg-gray-100 transition-colors duration-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
        
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="md:hidden hidden border-t border-gray-200 dark:border-gray-700">
          <div class="py-4 space-y-3">
            <a 
              href={lang === "en" ? "/" : `/${lang}/`} 
              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname === "/" || Astro.url.pathname === `/${lang}/` ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('home')}
            </a>
            <a 
              href={lang === "en" ? "/features" : `/${lang}/features`} 
              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/features" : `/${lang}/features`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
