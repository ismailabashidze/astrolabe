            >
              {t('pricing')}
            </a>
            <a 
              href={lang === "en" ? "/about" : `/${lang}/about`} 
              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/about" : `/${lang}/about`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('about')}
            </a>
            <a 
              href={lang === "en" ? "/community" : `/${lang}/community`} 
              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/community" : `/${lang}/community`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('community')}
            </a>
            <a 
              href={lang === "en" ? "/team" : `/${lang}/team`} 
              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/team" : `/${lang}/team`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('team')}
            </a>
            <a 
              href={lang === "en" ? "/contact" : `/${lang}/contact`} 
              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/contact" : `/${lang}/contact`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('contact')}
            </a>
            <div class="px-4 pt-2 border-t border-gray-200 mt-2 flex items-center space-x-4 dark:border-gray-700">
              <ThemeSwitcher />
              <LanguageSelector currentLang={lang} lang={lang} dir={dir} />
              <button class="w-full mt-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-4 py-2 rounded-lg font-medium hover:from-indigo-700 hover:to-purple-700 transition-all duration-200 dark:from-indigo-700 dark:to-purple-700 dark:hover:from-indigo-800 dark:hover:to-purple-800">
                {t('signUp')}
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>
    
    <main class="py-8 min-h-[calc(100vh-200px)] dark:bg-gray-900">
      <div class="container mx-auto px-4">
        <div class="page-transition page-enter">
          <slot />
        </div>
      </div>
    </main>
    
    <footer class="bg-gradient-to-r from-indigo-900 to-purple-900 text-white">
      <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="lg:col-span-2">
            <div class="flex items-center space-x-3 mb-4 flex-row ">
              <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center">
                <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-12 h-12" />
              </div>
              <h2 class="text-2xl font-serif font-bold">{lang === "en" ? "Astrolabe" : "اسطرلاب"}</h2>
            </div>
            <p class="text-indigo-200 max-w-md mb-6">
