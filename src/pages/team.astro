---
// src/pages/team.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Team members data - Zehna Platform Team
const teamMembers = [
  {
    name: "Dr. Hadi Bahrami Ehsan",
    role: "Founder & Chief Scientist",
    bio: "Full Professor at University of Tehran. Specialist in combining artificial intelligence with psychological sciences to create accessible mental health solutions.",
    image: "/images/team/hadi.jpg",
    social: {
      linkedin: "https://www.linkedin.com/",
      medium: "#"
    }
  },
  {
    name: "Alex Morgan",
    role: "AI Research Lead",
    bio: "PhD in Artificial Intelligence with focus on psychological pattern recognition. Former NASA engineer with expertise in complex data analysis.",
    image: "/images/team/alex.jpg",
    social: {
      twitter: "#",
      github: "#",
      linkedin: "#"
    }
  },
  {
    name: "Sam Rivera",
    role: "Lead Developer",
    bio: "Senior software engineer with experience in building scalable mental health platforms. Specializes in secure data handling and privacy protection.",
    image: "/images/team/sam.jpg",
    social: {
      twitter: "#",
      github: "#"
    }
  },
  {
    name: "Jordan Patel",
    role: "UX/UI Designer",
    bio: "Creates intuitive interfaces that make complex psychological concepts accessible to everyone. Focuses on inclusive design for diverse user needs.",
    image: "/images/team/jordan.jpg",
    social: {
      twitter: "#",
      dribbble: "#"
    }
  },
  {
    name: "Taylor Kim",
    role: "Content Strategy Lead",
    bio: "Psychology educator and writer passionate about making evidence-based mental health resources accessible. Former university lecturer.",
    image: "/images/team/taylor.jpg",
    social: {
      twitter: "#",
      medium: "#"
    }
  },
  {
    name: "Amara Johnson",
    role: "Community Manager",
    bio: "Builds and nurtures our vibrant community of mental health enthusiasts and practitioners. Focuses on user engagement and support.",
    image: "/images/team/amara.jpg",
    social: {
      twitter: "#",
      instagram: "#"
    }
  },
  {
    name: "David Chen",
    role: "Data Scientist",
    bio: "Applies machine learning to uncover patterns in psychological data and improve our mental health predictions and interventions.",
    image: "/images/team/david.jpg",
    social: {
      twitter: "#",
      linkedin: "#"
    }
  }
];
---

<MainLayout title="Our Team - Zehna" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6">Meet Our Team</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Passionate experts combining psychological science with modern technology to bring you the best mental health tools
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {teamMembers.map((member, index) => (
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300">
            <div class="p-6">
              <div class="flex items-center mb-5">
                <div class="w-16 h-16 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mr-4">
                  <span class="text-white font-bold text-xl">{member.name.charAt(0)}</span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white">{member.name}</h3>
                  <p class="text-indigo-600 dark:text-indigo-400">{member.role}</p>
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-5">{member.bio}</p>
              <div class="flex space-x-4">
                {member.social.twitter && (
                  <a href={member.social.twitter} class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <span class="sr-only">Twitter</span>
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
                    </svg>
                  </a>
                )}
                {member.social.linkedin && (
                  <a href={member.social.linkedin} class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <span class="sr-only">LinkedIn</span>
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                    </svg>
                  </a>
                )}
                {member.social.github && (
                  <a href={member.social.github} class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <span class="sr-only">GitHub</span>
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
                    </svg>
                  </a>
                )}
                {member.social.medium && (
                  <a href={member.social.medium} class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <span class="sr-only">Medium</span>
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M0 0v24h24V0H0zm19.938 5.686L18.651 6.92a.376.376 0 0 0-.143.362v9.067a.376.376 0 0 0 .143.361l1.257 1.234v.271h-6.322v-.27l1.302-1.265c.128-.128.128-.165.128-.36V8.99l-3.65 9.195h-.49L6.69 8.99v6.163a.85.85 0 0 0 .233.707l1.694 2.054v.271H3.815v-.27L5.51 15.86a.82.82 0 0 0 .218-.707V8.102c0-.306-.075-.374-.265-.374-.11 0-.23.01-.348.034v-.31L7.79 7.215h.49l2.975 7.25 2.606-7.25h.49l2.778.237v.31l-.408.236c-.037 0-.098.01-.183.028-.11.028-.183.047-.22.047-.092 0-.154-.064-.154-.22V7.59z"/>
                    </svg>
                  </a>
                )}
                {member.social.instagram && (
                  <a href={member.social.instagram} class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <span class="sr-only">Instagram</span>
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                )}
                {member.social.dribbble && (
                  <a href={member.social.dribbble} class="text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <span class="sr-only">Dribbble</span>
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.384-.438 1.34 3.684 1.887 6.684 1.992 7.308 2.3-1.555 3.936-4.02 4.392-6.87zm-6.115 7.808c-.153-.9-.75-4.032-2.19-7.77l-.068-.182c-2.736 1.89-6.408 3.246-10.35 3.726.756 4.668 4.457 8.22 9.06 8.22 1.211 0 2.366-.256 3.422-.715l.196-.098-.002-.034c.024-.12.05-.24.072-.36zm-9.922-2.745c.534-.06 1.266-.138 2.154-.24 1.175-2.73 2.964-4.94 5.106-6.348-2.616-2.4-6.36-3.996-10.518-4.116.18 3.732 1.8 7.02 4.26 9.708zm-4.115-11.327c1.518.162 3.816.558 6.732 1.62 2.556-1.602 4.026-2.658 4.212-2.79-1.512-1.368-3.438-2.178-5.544-2.178-3.45 0-6.354 2.232-7.404 5.34zm11.39 1.71c-.216.162-1.878 1.368-4.842 3.258 2.466 1.638 4.152 3.936 4.872 6.576.036-.21.066-.42.096-.63.072-.426.126-.864.156-1.308.048-.72.078-1.476.078-2.268 0-2.796-.438-5.382-1.356-7.536z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 md:p-12 text-white">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">Join Our Mission</h2>
          <p class="text-xl text-indigo-100 mb-8">
            We're always looking for passionate individuals to join our team. If you share our vision for making mental health accessible to everyone, we'd love to hear from you.
          </p>
          <button class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
            View Open Positions
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>