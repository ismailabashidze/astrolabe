// src/components/Testimonials.astro
// Accept locale as a prop
const { locale = "en" } = Astro.props;

let t;
if (locale === 'fa') {
  const module = await import('../i18n/fa.json');
  t = module.default;
} else {
  // Default to English
  const module = await import('../i18n/en.json');
  t = module.default;
}

// Define all testimonials data using translations
const allTestimonials = [
  {
    id: 1,
    name: t.testimonials.testimonial1.name,
    role: t.testimonials.testimonial1.role,
    quote: t.testimonials.testimonial1.quote,
    avatar: "/images/1.jpg",
    bgColor: "bg-indigo-100 dark:bg-indigo-900/30"
  },
  {
    id: 2,
    name: t.testimonials.testimonial2.name,
    role: t.testimonials.testimonial2.role,
    quote: t.testimonials.testimonial2.quote,
    avatar: "/images/2.jpg",
    bgColor: "bg-purple-100 dark:bg-purple-900/30"
  },
  {
    id: 3,
    name: t.testimonials.testimonial3.name,
    role: t.testimonials.testimonial3.role,
    quote: t.testimonials.testimonial3.quote,
    avatar: "/images/3.jpg",
    bgColor: "bg-pink-100 dark:bg-pink-900/30"
  },
  {
    id: 4,
    name: t.testimonials.testimonial4.name,
    role: t.testimonials.testimonial4.role,
    quote: t.testimonials.testimonial4.quote,
    avatar: "/images/4.jpg",
    bgColor: "bg-blue-100 dark:bg-blue-900/30"
  },
  {
    id: 5,
    name: t.testimonials.testimonial5.name,
    role: t.testimonials.testimonial5.role,
    quote: t.testimonials.testimonial5.quote,
    avatar: "/images/5.jpg",
    bgColor: "bg-green-100 dark:bg-green-900/30"
  },
  {
    id: 6,
    name: t.testimonials.testimonial6.name,
    role: t.testimonials.testimonial6.role,
    quote: t.testimonials.testimonial6.quote,
    avatar: "/images/6.jpg",
    bgColor: "bg-yellow-100 dark:bg-yellow-900/30"
  },
  {
    id: 7,
    name: t.testimonials.testimonial7.name,
    role: t.testimonials.testimonial7.role,
    quote: t.testimonials.testimonial7.quote,
    avatar: "/images/7.jpg",
    bgColor: "bg-red-100 dark:bg-red-900/30"
  },
  {
    id: 8,
    name: t.testimonials.testimonial8.name,
    role: t.testimonials.testimonial8.role,
    quote: t.testimonials.testimonial8.quote,
    avatar: "/images/8.jpg",
    bgColor: "bg-teal-100 dark:bg-teal-900/30"
  },
  {
    id: 9,
    name: t.testimonials.testimonial9.name,
    role: t.testimonials.testimonial9.role,
    quote: t.testimonials.testimonial9.quote,
    avatar: "/images/9.jpg",
    bgColor: "bg-orange-100 dark:bg-orange-900/30"
  },
  {
    id: 10,
    name: t.testimonials.testimonial10.name,
    role: t.testimonials.testimonial10.role,
    quote: t.testimonials.testimonial10.quote,
    avatar: "/images/10.jpg",
    bgColor: "bg-cyan-100 dark:bg-cyan-900/30"
  },
  {
    id: 11,
    name: t.testimonials.testimonial11.name,
    role: t.testimonials.testimonial11.role,
    quote: t.testimonials.testimonial11.quote,
    avatar: "/images/11.jpg",
    bgColor: "bg-lime-100 dark:bg-lime-900/30"
  },
  {
    id: 12,
    name: t.testimonials.testimonial12.name,
    role: t.testimonials.testimonial12.role,
    quote: t.testimonials.testimonial12.quote,
    avatar: "/images/12.jpg",
    bgColor: "bg-emerald-100 dark:bg-emerald-900/30"
  }
];

// Group testimonials into sets of 3
const groupedTestimonials = [];
for (let i = 0; i < allTestimonials.length; i += 3) {
  groupedTestimonials.push(allTestimonials.slice(i, i + 3));
}

// Convert to JSON for use in Alpine.js
const testimonialsJSON = JSON.stringify(groupedTestimonials);
---

<section class="my-20">
  <div class="text-center mb-16">
    <div class="flex items-center justify-center mb-8">
      <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mr-3">
        <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-12 h-12" />
      </div>
      <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">{t.testimonials.title}</h2>
    </div>
    <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
      {t.testimonials.subtitle}
    </p>
  </div>
  
  <div class="relative max-w-6xl mx-auto" x-data="testimonialCarousel()" x-init="initCarousel()">
    <!-- Carousel container -->
    <div class="overflow-hidden rounded-2xl">
      <div 
        class="flex transition-transform duration-500 ease-in-out"
        :style="`transform: translateX(-${currentIndex * 100}%)`"
      >
        <!-- Testimonial slides - pre-render all groups -->
        {groupedTestimonials.map((group, groupIndex) => (
          <div class="flex-shrink-0 w-full grid grid-cols-1 md:grid-cols-3 gap-8 p-2" :key={groupIndex}>
            {group.map((testimonial) => (
              <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-shadow duration-300">
                <div class="flex items-center mb-4">
                  <div class={`w-16 h-16 rounded-full flex items-center justify-center mr-4 overflow-hidden ${testimonial.bgColor}`}>
                    <img 
                      src={testimonial.avatar} 
                      alt={testimonial.name} 
                      class="w-full h-full object-cover"
                      width="100" 
                      height="100"
                    />
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900 dark:text-white">{testimonial.name}</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{testimonial.role}</p>
                  </div>
                </div>
                <p class="text-gray-700 dark:text-gray-300 italic">{testimonial.quote}</p>
                <div class="flex mt-4">
                  {[...Array(5)].map((_, i) => (
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
    
    <!-- Pagination dots -->
    <div class="flex justify-center mt-8 space-x-2">
      {groupedTestimonials.map((_, index) => (
        <button 
          @click="goToSlide({index})" 
          :class="currentIndex === {index} ? 'bg-indigo-600 w-6' : 'bg-gray-300 dark:bg-gray-600'"
          class="w-3 h-3 rounded-full transition-all duration-300 focus:outline-none"
          :aria-label="`Go to testimonial group ${index + 1}`"
        ></button>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  function testimonialCarousel() {
    return {
      currentIndex: 0,
      interval: null,
      initCarousel() {
        // Auto-advance testimonials every 5 seconds
        this.interval = setInterval(() => {
          this.next();
        }, 5000);
        
        // Pause auto-advance when user hovers over the carousel
        this.$el.addEventListener('mouseenter', () => {
          clearInterval(this.interval);
        });
        
        // Resume auto-advance when user stops hovering
        this.$el.addEventListener('mouseleave', () => {
          this.interval = setInterval(() => {
            this.next();
          }, 5000);
        });
      },
      next() {
        this.currentIndex = (this.currentIndex + 1) % {groupedTestimonials.length};
      },
      prev() {
        this.currentIndex = (this.currentIndex - 1 + {groupedTestimonials.length}) % {groupedTestimonials.length};
      },
      goToSlide(index) {
        this.currentIndex = index;
      }
    }
  }
</script>
---

<section class="my-20">
  <div class="text-center mb-16">
    <div class="flex items-center justify-center mb-8">
      <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mr-3">
        <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-12 h-12" />
