---
// src/pages/fa/blog.astro
import MainLayout from '../../../layouts/MainLayout.astro';
import NewsletterSignup from '../../../components/NewsletterSignup.astro';
import { getTranslation, isRTL } from '../../../utils/i18n.js';
import { Image } from 'astro:assets';

// Import images directly
import image1 from '../../../../public/images/6.jpg';
import image2 from '../../../../public/images/7.jpg';
import image3 from '../../../../public/images/8.jpg';
import image4 from '../../../../public/images/9.jpg';
import image5 from '../../../../public/images/10.jpg';
import image6 from '../../../../public/images/11.jpg';
import image12 from '../../../../public/images/12.jpg';
import image13 from '../../../../public/images/13.jpg';
import image14 from '../../../../public/images/14.jpg';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Sample blog posts data with Persian translations
const blogPosts = [
  {
    id: 1,
    title: "درک نشان خورشیدی شما: راهنمایی برای ۱۲ نشان زودیاک",
    excerpt: "ویژگی‌ها، نقاط قوت و چالش‌های منحصر به فرد هر نشان زودیاک و تأثیر آن‌ها بر شخصیت شما را کشف کنید.",
    date: "2023-08-15",
    author: "سارا جانسون",
    category: "نشان‌های زودیاک",
    readTime: "۵ دقیقه مطالعه",
    image: image1,
    featured: true
  },
  {
    id: 2,
    title: "قدرت عقب‌نشینی عطارد: چه معنایی برای شما دارد؟",
    excerpt: "بدانید که عقب‌نشینی عطارد چگونه بر ارتباطات، فناوری و سفر تأثیر می‌گذارد و چگونه می‌توانید این پدیده کیهانی را هدایت کنید.",
    date: "2023-07-22",
    author: "مایکل رودریگز",
    category: "حرکات سیاره‌ای",
    readTime: "۷ دقیقه مطالعه",
    image: image2
  },
  {
    id: 3,
    title: "سیناستری: هنر منجمی رابطه",
    excerpt: "کشف کنید که چگونه مقایسه چارت‌های تولد می‌تواند پویایی‌ها، سازگاری و چالش‌های احتمالی در روابط را آشکار کند.",
    date: "2023-06-30",
    author: "اما چن",
    category: "روابط",
    readTime: "۸ دقیقه مطالعه",
    image: image3
  },
  {
    id: 4,
    title: "گره‌های قمری: مسیر کارمایی شما در این زندگی",
    excerpt: "اهمیت گره شمالی و جنوبی و چگونگی هدایت سفر معنوی و هدف زندگی شما را درک کنید.",
    date: "2023-05-18",
    author: "دیوید تامسون",
    category: "منجمی پیشرفته",
    readTime: "۶ دقیقه مطالعه",
    image: image4
  },
  {
    id: 5,
    title: "سامانه‌های خانه در منجمی: کدام یک برای شما مناسب است؟",
    excerpt: "راهنمای جامع برای سامانه‌های مختلف خانه و تأثیر آن‌ها بر تفسیر چارت تولد شما.",
    date: "2023-04-25",
    author: "لیسا اندرسون",
    category: "تفسیر چارت",
    readTime: "۹ دقیقه مطالعه",
    image: image5
  },
  {
    id: 6,
    title: "خورشیدگرفتگی‌ها در منجمی: رویدادهای کیهانی و اهمیت آن‌ها",
    excerpt: "کشف کنید که خورشیدگرفتگی‌ها و ماه‌گرفتگی‌ها چگونه بر زندگی شما تأثیر می‌گذارند و چه چیزی را باید در فصل‌های خورشیدگرفتگی انتظار داشته باشید.",
    date: "2023-03-12",
    author: "رابرت کیم",
    category: "رویدادهای کیهانی",
    readTime: "۷ دقیقه مطالعه",
    image: image6
  }
];

// Separate featured post from regular posts
const featuredPost = blogPosts.find(post => post.featured) || blogPosts[0];
const regularPosts = blogPosts.filter(post => !post.featured);
---

<MainLayout title="بلاگ - اسطرلاب" lang={lang} dir={dir}>
  <!-- Hero Section with Background Image -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-900/90 to-purple-900/90"></div>
    <div class="absolute inset-0 pattern-bg opacity-30"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-white mb-6">بلاگ منجمی</h1>
        <p class="text-xl text-indigo-100 max-w-2xl mx-auto mb-10">
          آخرین بینش‌ها، تفسیرها و کشف‌ها در دنیای منجمی را کاوش کنید
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <span class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-indigo-100 border border-white/20">بینش‌های منجمی</span>
          <span class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-indigo-100 border border-white/20">راهنمای نشان‌ها</span>
          <span class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-indigo-100 border border-white/20">رویدادهای کیهانی</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container mx-auto px-4">
      <!-- Featured Post -->
      <div class="mb-16">
        <article class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-2xl transition-all duration-500 card-hover">
          <div class="md:flex">
            <div class="md:w-1/2 flex justify-start">
              <div class="h-64 md:h-full w-full overflow-hidden flex items-center">
                <Image 
                  src={featuredPost.image} 
                  alt={featuredPost.title} 
                  class="w-full h-auto object-contain"
                  format="webp"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="md:w-1/2 p-8">
              <div class="flex items-center justify-between mb-4">
                <span class="text-sm font-medium text-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 dark:text-indigo-300 px-3 py-1 rounded-full">{featuredPost.category}</span>
                <span class="px-3 py-1 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-bold rounded-full">ویژه</span>
              </div>
              <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 dark:text-white mb-4 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                <a href={`/fa/blog/${featuredPost.id}`}>{featuredPost.title}</a>
              </h2>
              <p class="text-gray-600 dark:text-gray-300 mb-6">{featuredPost.excerpt}</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mr-3">
                    <span class="text-sm font-bold text-white">{featuredPost.author.charAt(0)}</span>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900 dark:text-white">{featuredPost.author}</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{new Date(featuredPost.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} · {featuredPost.readTime}</p>
                  </div>
                </div>
                <a href={`/fa/blog/${featuredPost.id}`} class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 font-medium flex items-center transition-colors duration-200">
                  ادامه مطلب
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <div class="lg:w-2/3">
          <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-6">آخرین مقالات</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {regularPosts.map(post => (
              <article class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 card-hover">
                <!-- Featured Image -->
                <div class="h-48 overflow-hidden">
                  <Image 
                    src={post.image} 
                    alt={post.title} 
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
                    format="webp"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 dark:text-indigo-300 px-3 py-1 rounded-full">{post.category}</span>
                    <span class="text-sm text-gray-500 dark:text-gray-400">{post.readTime}</span>
                  </div>
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200">
                    <a href={`/fa/blog/${post.id}`}>{post.title}</a>
                  </h2>
                  <p class="text-gray-600 dark:text-gray-300 mb-4">{post.excerpt}</p>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="w-8 h-8 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mr-2">
                        <span class="text-xs font-bold text-white">{post.author.charAt(0)}</span>
                      </div>
                      <span class="text-sm text-gray-700 dark:text-gray-300">{post.author}</span>
                    </div>
                    <span class="text-sm text-gray-500 dark:text-gray-400">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
          
          <!-- Pagination -->
          <div class="flex justify-center mt-12">
            <nav class="flex items-center space-x-2">
              <a href="#" class="px-4 py-2 rounded-md bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md hover:shadow-lg transition-all duration-300">۱</a>
              <a href="#" class="px-4 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300">۲</a>
              <a href="#" class="px-4 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300">۳</a>
              <span class="px-4 py-2 text-gray-500 dark:text-gray-400">...</span>
              <a href="#" class="px-4 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300">۱۰</a>
              <a href="#" class="px-4 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </nav>
          </div>
        </div>
        
        <div class="lg:w-1/3">
          <!-- Categories -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 mb-8 card">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">دسته‌بندی‌ها</h3>
            <ul class="space-y-3">
              <li>
                <a href="#" class="flex justify-between items-center text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 group">
                  <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    نشان‌های زودیاک
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">(۱۲)</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex justify-between items-center text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 group">
                  <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    حرکات سیاره‌ای
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">(۸)</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex justify-between items-center text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 group">
                  <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    روابط
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">(۶)</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex justify-between items-center text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 group">
                  <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    منجمی پیشرفته
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">(۱۰)</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex justify-between items-center text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 group">
                  <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    تفسیر چارت
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">(۷)</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex justify-between items-center text-gray-700 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 group">
                  <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    رویدادهای کیهانی
                  </span>
                  <span class="text-gray-500 dark:text-gray-400">(۵)</span>
                </a>
              </li>
            </ul>
          </div>
          
          <!-- Popular Posts -->
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 mb-8 card">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6">پست‌های محبوب</h3>
            <ul class="space-y-5">
              <li>
                <a href="#" class="group flex items-start">
                  <div class="w-16 h-16 rounded-lg overflow-hidden mr-4 flex-shrink-0">
                    <Image 
                      src={image12} 
                      alt="راهنمای کامل چارت تولد شما" 
                      class="w-full h-full object-cover"
                      width={200}
                      height={150}
                      format="webp"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 leading-tight">راهنمای کامل چارت تولد شما</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">۱۵ اسفند ۱۴۰۱ · ۱۰ دقیقه مطالعه</p>
                  </div>
                </a>
              </li>
              <li>
                <a href="#" class="group flex items-start">
                  <div class="w-16 h-16 rounded-lg overflow-hidden mr-4 flex-shrink-0">
                    <Image 
                      src={image13} 
                      alt="چگونه چارت عبور خود را بخوانید" 
                      class="w-full h-full object-cover"
                      width={200}
                      height={150}
                      format="webp"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 leading-tight">چگونه چارت عبور خود را بخوانید</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">۹ بهمن ۱۴۰۱ · ۸ دقیقه مطالعه</p>
                  </div>
                </a>
              </li>
              <li>
                <a href="#" class="group flex items-start">
                  <div class="w-16 h-16 rounded-lg overflow-hidden mr-4 flex-shrink-0">
                    <Image 
                      src={image14} 
                      alt="تأثیر ماه در زندگی شما" 
                      class="w-full h-full object-cover"
                      width={200}
                      height={150}
                      format="webp"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-200 leading-tight">تأثیر ماه در زندگی شما</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">۲۰ دی ۱۴۰۱ · ۶ دقیقه مطالعه</p>
                  </div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Newsletter Signup - Full Width Row -->
      <div class="mt-12">
        <NewsletterSignup lang={lang} />
      </div>
    </div>
  </section>
</MainLayout>