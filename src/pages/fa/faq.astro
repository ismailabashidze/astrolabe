---
// src/pages/fa/faq.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { getTranslation, isRTL } from '../../utils/i18n.js';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// FAQ data in Persian
const faqCategories = [
  {
    category: "سؤالات عمومی",
    questions: [
      {
        question: "ذهنا چیست؟",
        answer: "ذهنا یک ابر برنامه هوش مصنوعی مبتنی بر روانشناسی است که خدمات گسترده‌ای در حوزه سلامت روان و روابط انسانی ارائه می‌دهد. ما با ترکیب فناوری پیشرفته هوش مصنوعی و دانش روانشناسی بالینی، راهکارهایی نوآورانه برای بهبود کیفیت زندگی ارائه می‌دهیم. ذهنا به دنبال پل‌کردن شکاف بین نیازهای روانی انسان‌ها و دسترسی به خدمات تخصصی روانشناسی است، به‌ویژه برای اقشار کمتر برخوردار و در شرایط بحرانی."
      },
      {
        question: "ذهنا چه محصولاتی ارائه می‌دهد؟",
        answer: "ذهنا شامل چندین محصول تخصصی است: هم‌دل (حمایت عاطفی 24/7)، هم‌مسیر (مشاوره زناشویی و همسان‌سازی علمی)، هم‌پای مادر (حمایت از مادران و کودکان)، به‌هم (پلتفرم اشتراک منابع)، درمانیا (تشخیص روانشناختی مبتنی بر DSM-5 و PDM-2)، کاناپه (یادگیری مهارت‌های روانشناسی از طریق نقش‌آفرینی)، سیناپس (هوش مصنوعی برای منابع انسانی) و خبره (پلتفرم جمع‌آوری اخبار و بینش‌های اجتماعی). هر محصول به یک حوزه خاص از زندگی روانی و اجتماعی پرداخته و با استانداردهای علمی و روانشناختی به‌روز طراحی شده است."
      },
      {
        question: "آیا استفاده از ذهنا رایگان است؟",
        answer: "ذهنا مدل فریمیوم دارد. برخی خدمات پایه رایگان هستند، اما برای دسترسی به محصولات پیشرفته و خدمات تخصصی نیاز به اشتراک دارید. برنامه‌های مختلفی برای افراد، خانواده‌ها و سازمان‌ها ارائه می‌دهیم. همچنین برنامه‌های ویژه‌ای برای گروه‌های کمتر برخوردار نیز در نظر گرفته شده است تا دسترسی عادلانه به خدمات روانشناختی فراهم شود."
      },
      {
        question: "ذهنا چه تفاوتی با سایر برنامه‌های روانشناسی دارد؟",
        answer: "ذهنا با ترکیب هوش مصنوعی پیشرفته و دانش روانشناسی بالینی، تجربه‌ای شخصی‌سازی‌شده و در عین حال علمی ارائه می‌دهد. همچنین با تمرکز بر بومی‌سازی و فرهنگ‌محور بودن، راهکارهایی متناسب با فرهنگ ایرانی و ارزش‌های اسلامی ارائه می‌دهد. ذهنا همچنین تلاش دارد با ارائه خدمات در حوزه‌های مختلف زندگی (از تربیت فرزند گرفته تا روابط زناشویی و منابع انسانی)، یک پلتفرم جامع و یکپارچه برای بهبود کیفیت زندگی فراهم کند."
      }
    ]
  },
  {
    category: "پشتیبانی فنی",
    questions: [
      {
        question: "ذهنا از چه مرورگرهایی پشتیبانی می‌کند؟",
        answer: "ذهنا در تمام مرورگرهای مدرن از جمله Chrome، Firefox، Safari و Edge کار می‌کند. ما توصیه می‌کنیم از آخرین نسخه مرورگر مورد نظر خود برای بهترین تجربه استفاده کنید. همچنین برنامه‌های اختصاصی برای iOS و Android نیز در دسترس هستند که می‌توانید از فروشگاه‌های مربوطه دانلود کنید."
      },
      {
        question: "آیا می‌توانم از ذهنا روی دستگاه موبایلم استفاده کنم؟",
        answer: "بله، ذهنا کاملاً واکنش‌گرا است و در گوشی‌های هوشمند و تبلت‌ها عالی کار می‌کند. تجربه موبایل ما برای تعامل لمسی و صفحات کوچک‌تر بهینه‌سازی شده است. همچنین برنامه‌های اختصاصی برای iOS و Android طراحی شده‌اند که محصولات بیشتری نسبت به نسخه وب ارائه می‌دهند."
      },
      {
        question: "چگونه می‌توانم یک اشکال یا مشکل فنی را گزارش کنم؟",
        answer: "می‌توانید اشکالات یا مشکلات فنی را از طریق صفحه تماس یا ایمیل support@zehna.ir گزارش کنید. لطفاً جزئیات دستگاه، مرورگر و مراحل بازتولید مشکل را ارائه دهید. همچنین در برنامه‌های موبایل، بخش گزارش اشکال در تنظیمات در دسترس است. تیم فنی ما 24 ساعته آماده پاسخگویی است."
      },
      {
        question: "آیا ذهنا به‌روزرسانی می‌شود؟",
        answer: "بله، ذهنا به‌طور مداوم به‌روزرسانی می‌شود. ما هفتگی به‌روزرسانی‌های امنیتی و عملکردی منتشر می‌کنیم و به‌طور منظم محصولات جدید اضافه می‌کنیم. تمام به‌روزرسانی‌ها به‌طور خودکار انجام می‌شوند و نیازی به اقدام کاربر ندارند."
      },
    ]
  },
  {
    category: "حساب و صورتحساب",
    questions: [
      {
        question: "چگونه می‌توانم یک حساب کاربری ایجاد کنم؟",
        answer: "می‌توانید با کلیک بر روی دکمه 'ثبت نام' در گوشه بالای سمت راست وب‌سایت ما، یک حساب کاربری ایجاد کنید. شما باید آدرس ایمیل خود را ارائه دهید و یک رمز عبور ایجاد کنید. همچنین می‌توانید از طریق شبکه‌های اجتماعی یا شماره تلفن همراه خود وارد شوید. فرآیند ثبت‌نام کمتر از یک دقیقه طول می‌کشد."
      },
      {
        question: "آیا می‌توانم اشتراک خود را تغییر دهم یا لغو کنم؟",
        answer: "بله، می‌توانید اشتراک خود را در هر زمان از تنظیمات حساب خود ارتقاء، کاهش یا لغو کنید. تغییرات بلافاصله اعمال می‌شوند و ما ضمانت بازپس‌گیری ۳۰ روزه برای تمام پلن‌های پولی ارائه می‌دهیم. در صورت لغو اشتراک، دسترسی شما تا پایان دوره پرداخت‌شده حفظ می‌شود."
      },
      {
        question: "چه روش‌های پرداختی را می‌پذیرید؟",
        answer: "ما تمام کارت‌های اعتباری اصلی از جمله Visa، Mastercard و American Express را می‌پذیریم. ما همچنین از PayPal، کیف پول‌های الکترونیکی و انتقالات بانکی برای اشتراک‌های سالانه پشتیبانی می‌کنیم. برای کاربران ایرانی، درگاه‌های پرداخت محلی نیز در دسترس است."
      },
      {
        question: "آیا برای دانشجویان و دانش‌آموزان تخفیف دارید؟",
        answer: "بله، برای دانشجویان و دانش‌آموزان کد تخفیف ویژه‌ای در نظر گرفته شده است. همچنین برنامه‌های آموزشی ویژه‌ای برای مراکز آموزشی طراحی کرده‌ایم. برای دریافت تخفیف، از طریق صفحه تماس با ما اقدام کنید."
      }
    ]
  },
  {
    category: "سؤالات روانشناسی",
    questions: [
      {
        question: "آیا هوش مصنوعی ذهنا جایگزین مشاوره روانشناسی است؟",
        answer: "نه، هوش مصنوعی ذهنا جایگزین مشاوره روانشناسی حضوری نیست، بلکه مکمل آن عمل می‌کند. هوش مصنوعی ذهنا برای حمایت روزانه، ارائه راهکارهای اولیه و آموزش مهارت‌های خودمدیریتی طراحی شده است. برای مسائل پیچیده‌تر و تشخیص‌های تخصصی، در درمانیا و سایر محصولات امکان ارتباط با متخصصان انسانی فراهم شده است."
      },
      {
        question: "آیا اطلاعات من در ذهنا ایمن است؟",
        answer: "بله، حفظ حریم خصوصی و امنیت اطلاعات کاربران اولویت اصلی ما است. تمام داده‌ها رمزگذاری شده و بر روی سرورهای امن داخلی ذخیره می‌شوند. ما از استانداردهای بین‌المللی امنیتی پیروی می‌کنیم و متعهد به رعایت قوانین حفاظت از داده‌ها هستیم. هیچ اطلاعات شخصی شما با افراد ثالث به اشتراک گذاشته نمی‌شود."
      },
      {
        question: "آیا مشاوره روانشناسی ارائه می‌دهید؟",
        answer: "در برخی از محصولات ما مانند هم‌پای مادر و هم‌مسیر، روانشناسان انسانی نیز فعالیت می‌کنند و مشاوره تخصصی ارائه می‌دهند. همچنین در درمانیا امکان ارتباط با متخصصان را دارید. مشاوره‌های انسانی از طریق چت، تماس صوتی و تصویری در دسترس هستند و با توجه به تخصص و تجربه هر روانشناس قیمت‌گذاری می‌شوند."
      },
      {
        question: "آیا ذهنا می‌تواند کمک کند تا خودکشی را پیشگیری کند؟",
        answer: "بله، یکی از اهداف کلیدی ذهنا پیشگیری از خودکشی است. سیستم ما با استفاده از الگوریتم‌های پیشرفته قادر است نشانه‌های هشداردهنده را شناسایی کند و بلافاصله مداخله کند. همچنین در شرایط بحرانی، امکان ارتباط فوری با متخصصان بحران‌گری فراهم است. ما با سازمان‌های مرتبط همکاری می‌کنیم تا این خدمات به‌طور مؤثر ارائه شوند."
      }
    ]
  }
];
---

<MainLayout title="سؤالات متداول - ذهنا" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-4">سؤالات متداول</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          پاسخ‌هایی برای سؤالات رایج درباره ذهنا و خدمات روانشناختی پیدا کنید
        </p>
      </div>
      
      <div x-data="faqAccordion()" class="max-w-4xl mx-auto">
        <template x-for="(category, catIndex) in faqCategories" :key="catIndex">
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700" x-text="category.category"></h2>
            <div class="space-y-6">
              <template x-for="(faq, index) in category.questions" :key="index">
                <div class="bg-white dark:bg-gray-700 rounded-xl shadow-md border border-gray-100 dark:border-gray-600 overflow-hidden">
                  <div @click="toggle(catIndex + '_' + index)" class="faq-question flex justify-between items-center p-6 cursor-pointer">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white" x-text="faq.question"></h3>
                    <svg class="w-5 h-5 text-gray-500 dark:text-gray-300 transform transition-transform duration-200" :class="{ 'rotate-180': openIndex === catIndex + '_' + index }" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <div x-show="openIndex === catIndex + '_' + index" x-transition class="faq-answer px-6 pb-6">
                    <p class="text-gray-600 dark:text-gray-200" x-text="faq.answer"></p>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
      
      <div class="bg-gradient-to-r from-primary to-secondary rounded-2xl p-8 md:p-12 text-white mt-16">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">هنوز سؤال دارید؟</h2>
          <p class="text-xl text-indigo-100 mb-8">
            نمی‌توانید پاسخ مورد نظر خود را پیدا کنید؟ تیم پشتیبانی ما اینجاست تا کمک کند.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/fa/contact" class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
              تماس با پشتیبانی
            </a>
            <a href="/fa/community" class="bg-transparent border-2 border-white text-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-colors duration-300">
              پیوستن به جامعه
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <script is:inline>
    function faqAccordion() {
      return {
        openIndex: null,
        toggle(index) {
          if (this.openIndex === index) {
            this.openIndex = null;
          } else {
            this.openIndex = index;
          }
        },
        faqCategories: [
          {
            category: "سؤالات عمومی",
            questions: [
              {
                question: "ذهنا چیست؟",
                answer: "ذهنا یک ابر برنامه هوش مصنوعی مبتنی بر روانشناسی است که خدمات گسترده‌ای در حوزه سلامت روان و روابط انسانی ارائه می‌دهد. ما با ترکیب فناوری پیشرفته هوش مصنوعی و دانش روانشناسی بالینی، راهکارهایی نوآورانه برای بهبود کیفیت زندگی ارائه می‌دهیم. ذهنا به دنبال پل‌کردن شکاف بین نیازهای روانی انسان‌ها و دسترسی به خدمات تخصصی روانشناسی است، به‌ویژه برای اقشار کمتر برخوردار و در شرایط بحرانی."
              },
              {
                question: "ذهنا چه محصولاتی ارائه می‌دهد؟",
                answer: "ذهنا شامل چندین محصول تخصصی است: هم‌دل (حمایت عاطفی 24/7)، هم‌مسیر (مشاوره زناشویی و همسان‌سازی علمی)، هم‌پای مادر (حمایت از مادران و کودکان)، به‌هم (پلتفرم اشتراک منابع)، درمانیا (تشخیص روانشناختی مبتنی بر DSM-5 و PDM-2)، کاناپه (یادگیری مهارت‌های روانشناسی از طریق نقش‌آفرینی)، سیناپس (هوش مصنوعی برای منابع انسانی) و خبره (پلتفرم جمع‌آوری اخبار و بینش‌های اجتماعی). هر محصول به یک حوزه خاص از زندگی روانی و اجتماعی پرداخته و با استانداردهای علمی و روانشناختی به‌روز طراحی شده است."
              },
              {
                question: "آیا استفاده از ذهنا رایگان است؟",
                answer: "ذهنا مدل فریمیوم دارد. برخی خدمات پایه رایگان هستند، اما برای دسترسی به محصولات پیشرفته و خدمات تخصصی نیاز به اشتراک دارید. برنامه‌های مختلفی برای افراد، خانواده‌ها و سازمان‌ها ارائه می‌دهیم. همچنین برنامه‌های ویژه‌ای برای گروه‌های کمتر برخوردار نیز در نظر گرفته شده است تا دسترسی عادلانه به خدمات روانشناختی فراهم شود."
              },
              {
                question: "ذهنا چه تفاوتی با سایر برنامه‌های روانشناسی دارد؟",
                answer: "ذهنا با ترکیب هوش مصنوعی پیشرفته و دانش روانشناسی بالینی، تجربه‌ای شخصی‌سازی‌شده و در عین حال علمی ارائه می‌دهد. همچنین با تمرکز بر بومی‌سازی و فرهنگ‌محور بودن، راهکارهایی متناسب با فرهنگ ایرانی و ارزش‌های اسلامی ارائه می‌دهد. ذهنا همچنین تلاش دارد با ارائه خدمات در حوزه‌های مختلف زندگی (از تربیت فرزند گرفته تا روابط زناشویی و منابع انسانی)، یک پلتفرم جامع و یکپارچه برای بهبود کیفیت زندگی فراهم کند."
              }
            ]
          },
          {
            category: "پشتیبانی فنی",
            questions: [
              {
                question: "ذهنا از چه مرورگرهایی پشتیبانی می‌کند؟",
                answer: "ذهنا در تمام مرورگرهای مدرن از جمله Chrome، Firefox، Safari و Edge کار می‌کند. ما توصیه می‌کنیم از آخرین نسخه مرورگر مورد نظر خود برای بهترین تجربه استفاده کنید. همچنین برنامه‌های اختصاصی برای iOS و Android نیز در دسترس هستند که می‌توانید از فروشگاه‌های مربوطه دانلود کنید."
              },
              {
                question: "آیا می‌توانم از ذهنا روی دستگاه موبایلم استفاده کنم؟",
                answer: "بله، ذهنا کاملاً واکنش‌گرا است و در گوشی‌های هوشمند و تبلت‌ها عالی کار می‌کند. تجربه موبایل ما برای تعامل لمسی و صفحات کوچک‌تر بهینه‌سازی شده است. همچنین برنامه‌های اختصاصی برای iOS و Android طراحی شده‌اند که محصولات بیشتری نسبت به نسخه وب ارائه می‌دهند."
              },
              {
                question: "چگونه می‌توانم یک اشکال یا مشکل فنی را گزارش کنم؟",
                answer: "می‌توانید اشکالات یا مشکلات فنی را از طریق صفحه تماس یا ایمیل support@zehna.ir گزارش کنید. لطفاً جزئیات دستگاه، مرورگر و مراحل بازتولید مشکل را ارائه دهید. همچنین در برنامه‌های موبایل، بخش گزارش اشکال در تنظیمات در دسترس است. تیم فنی ما 24 ساعته آماده پاسخگویی است."
