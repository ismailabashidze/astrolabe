---
// src/pages/features.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';
import { Image } from 'astro:assets';

// Import images
import hamdelImage from '@public/images/1.jpg';
import hammasirImage from '@public/images/6.png';
import hampayeMadarImage from '@public/images/4.jpg';
import bahamImage from '@public/images/7.jpg';
import darmanaImage from '@public/images/2.jpg';
import kanapeImage from '@public/images/3.jpg';
import synapseImage from '@public/images/11.jpg';
import khebrehImage from '@public/images/10.jpg';

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);
---

<MainLayout title="Zehna Products" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6">Zehna Products</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          A comprehensive suite of AI tools for every aspect of your psychological and social life
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <!-- Hamdel -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-red-50 dark:bg-gray-700 flex items-center justify-center mb-5">
            <span class="text-2xl">❤️</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Hamdel</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            AI for emotional support and psychological assistance during crises and stress
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={hamdelImage} 
              alt="Hamdel" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>24/7 crisis support</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Emotion and feeling detection</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Stress management techniques</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Detection of maladaptive behavioral patterns</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Personalized solution recommendations</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>User psychological progress tracking</span>
            </li>
          </ul>
          <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <h4 class="font-bold text-blue-800 dark:text-blue-200 mb-2">Key Products</h4>
            <p class="text-blue-700 dark:text-blue-300 text-sm">
              Hamdel uses advanced AI algorithms to provide 24/7 emotional support. The system can detect behavioral and emotional patterns of users and offer personalized solutions based on their specific needs. With machine learning capabilities, Hamdel continuously improves its understanding of each user's unique psychological profile.
            </p>
          </div>
          <div class="mt-4 flex gap-3">
            <a href="#" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              Visit Project
            </a>
            <a href="/hamdel" class="inline-block bg-white hover:bg-gray-100 text-blue-600 border border-blue-600 font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              More Details
            </a>
          </div>
        </div>
        
        <!-- Hammasir -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl">💍</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Hammasir</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            AI and psychologist support for romantic relationships, marriage and matchmaking
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={hammasirImage} 
              alt="Hammasir" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Marital compatibility analysis</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Relationship conflict resolution</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Scientific matchmaking</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Personality and life values assessment</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Effective communication skills training</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Pre-marriage counseling</span>
            </li>
          </ul>
          <div class="mt-6 p-4 bg-green-50 dark:bg-green-900/20 rounded-lg">
            <h4 class="font-bold text-green-800 dark:text-green-200 mb-2">Key Benefits</h4>
            <p class="text-green-700 dark:text-green-300 text-sm">
              Hammasir combines AI and psychological expertise to transform the process of meeting and marriage into a structured, scientific journey. Instead of focusing solely on external attractiveness, this system emphasizes deep psychological and value compatibility. The platform includes pre-marital counseling modules and ongoing relationship support tools to ensure long-term success.
            </p>
          </div>
          <div class="mt-4 flex gap-3">
            <a href="#" class="inline-block bg-[#3CAC88] hover:bg-[#99D2B4] text-white font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              Visit Project
            </a>
            <a href="/hammasir" class="inline-block bg-white hover:bg-gray-100 text-[#3CAC88] border border-[#3CAC88] font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              More Details
            </a>
          </div>
        </div>
        
        <!-- TogetherMama (TogetherMama) -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl">🤱</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">TogetherMama</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            AI and psychologist support for parents and child-rearing
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={hampayeMadarImage} 
              alt="TogetherMama" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Child-rearing guidance</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Parenting challenge resolution</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
