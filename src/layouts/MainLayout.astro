              class={`block px-4 py-2 font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/faq" : `/${lang}/faq`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
