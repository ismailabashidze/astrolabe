---
// src/components/Statistics.astro
import { Image } from 'astro:assets';
import image15 from '@public/images/15.jpg';
import { getTranslation } from '@utils/i18n.js';

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const t = (key) => getTranslation(lang, key);
---

<section class="my-20">
  <div class="bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-center mb-8">
      <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mr-3">
        <img src="/images/logo.svg" alt="Zehna Logo" class="w-12 h-12" />
      </div>
      <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mx-3">{t('statisticsTitle') || 'Zehna in Numbers'}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="grid grid-cols-2 gap-8 text-center">
        <div class="border-r-0 md:border-r border-gray-200 dark:border-gray-700 pb-6 md:pb-0 md:pr-8">
          <div class="text-4xl font-bold text-indigo-600 dark:text-indigo-400 mb-2">10K+</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">{t('activeUsers') || 'Active Users'}</h3>
          <p class="text-gray-600 dark:text-gray-300 mt-1">{t('usersDescription') || 'Astrology enthusiasts worldwide'}</p>
        </div>
        
        <div class="border-r-0 md:border-r border-gray-200 dark:border-gray-700 pb-6 md:pb-0 md:pr-8 pt-6 md:pt-0">
          <div class="text-4xl font-bold text-purple-600 dark:text-purple-400 mb-2">50K+</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">{t('chartsGenerated') || 'Charts Generated'}</h3>
          <p class="text-gray-600 dark:text-gray-300 mt-1">{t('chartsDescription') || 'Natal charts created daily'}</p>
        </div>
        
        <div class="border-r-0 md:border-r border-gray-200 dark:border-gray-700 pb-6 md:pb-0 md:pr-8 pt-6 md:pt-0">
          <div class="text-4xl font-bold text-pink-600 dark:text-pink-400 mb-2">12</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">{t('zodiacSigns') || 'Zodiac Signs'}</h3>
          <p class="text-gray-600 dark:text-gray-300 mt-1">{t('signsDescription') || 'Detailed interpretations for all'}</p>
        </div>
        
        <div class="pt-6 md:pt-0">
          <div class="text-4xl font-bold text-blue-600 dark:text-blue-400 mb-2">99.9%</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">{t('accuracy') || 'Accuracy'}</h3>
          <p class="text-gray-600 dark:text-gray-300 mt-1">{t('accuracyDescription') || 'Precision in calculations'}</p>
        </div>
      </div>
      <div class="flex justify-center">
        <div class="relative">
          <div class="absolute -top-4 -left-4 w-48 h-48 bg-purple-500 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob"></div>
          <div class="absolute -bottom-4 -right-4 w-48 h-48 bg-indigo-500 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-blob animation-delay-2000"></div>
          <div class="relative rounded-2xl overflow-hidden border-4 border-gray-200 dark:border-gray-700 shadow-xl">
            <Image 
              src={image15} 
              alt={t('statisticsImageAlt') || 'Astrological Statistics'} 
              class="w-full h-auto object-cover"
              width={400} 
              height={300}
              format="webp"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>