---
// src/layouts/MainLayout.astro
import '../styles/global.css';
import LanguageSelector from '../components/LanguageSelector.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { getTranslation } from '../utils/i18n.js';
const { title, lang = "en", dir = "ltr" } = Astro.props;
const t = (key) => getTranslation(lang, key);

// Function to determine if a link is active
const isActiveLink = (linkPath) => {
  // For the home page, we need special handling
  if (linkPath === "/" || linkPath === `/${lang}/`) {
    return Astro.url.pathname === "/" || Astro.url.pathname === `/${lang}/`;
  }
  
  // For other pages, check if the current path starts with the link path
  return Astro.url.pathname.startsWith(linkPath);
};
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content="Astro v5.13.4" />
    <title>{title}</title>
    <!-- Google Fonts: Inter for body text and Merriweather for headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@400;700;900&display=swap" rel="stylesheet">
    <!-- Alpine.js (kept on main thread for interactive components) -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body class="h-full bg-gradient-to-b from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-900" x-data>
    <!-- Theme initialization script -->
    <script is:inline src="/scripts/theme-init.js"></script>
    
    <header class="bg-white/90 backdrop-blur-lg border-b border-gray-200 sticky top-0 z-50 shadow-sm dark:bg-gray-800/90 dark:border-gray-700">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <!-- Logo -->
            <a href={lang === "en" ? "/" : `/${lang}/`} class="flex items-center space-x-2">
              <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center">
                <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-10 h-10" />
              </div>
              <span class="text-2xl font-serif font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                {lang === "en" ? "Astrolabe" : "اسطرلاب"}
              </span>
            </a>
          </div>
          
          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center space-x-1 navigation-links">
            <a 
              href={lang === "en" ? "/" : `/${lang}/`} 
              class={`px-4 py-2 rounded-lg font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname === "/" || Astro.url.pathname === `/${lang}/` ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('home')}
            </a>
            <a 
              href={lang === "en" ? "/features" : `/${lang}/features`} 
              class={`px-4 py-2 rounded-lg font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/features" : `/${lang}/features`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('features')}
            </a>
            <a 
              href={lang === "en" ? "/blog" : `/${lang}/blog`} 
              class={`px-4 py-2 rounded-lg font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/blog" : `/${lang}/blog`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('blog')}
            </a>
            <a 
              href={lang === "en" ? "/faq" : `/${lang}/faq`} 
              class={`px-4 py-2 rounded-lg font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/faq" : `/${lang}/faq`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('faq')}
            </a>
            <a 
              href={lang === "en" ? "/pricing" : `/${lang}/pricing`} 
              class={`px-4 py-2 rounded-lg font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/pricing" : `/${lang}/pricing`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('pricing')}
            </a>
            <a 
              href={lang === "en" ? "/about" : `/${lang}/about`} 
              class={`px-4 py-2 rounded-lg font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-200 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/about" : `/${lang}/about`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
            >
              {t('about')}
            </a>
            <!-- Dropdown for additional pages -->
            <div class="relative group hidden lg:block">
