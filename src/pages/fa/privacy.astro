---
// src/pages/fa/privacy.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);
---

<MainLayout title={t('privacyTitle')} lang={lang} dir={dir}>
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 pattern-bg"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">{t('privacyTitle')}</h1>
        <p class="text-xl md:text-2xl text-gray-700 max-w-2xl mx-auto">
          آخرین به‌روزرسانی: ۲۷ اوت ۲۰۲۵
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy Content -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="card">
          <div class="card-content">
            <div class="prose prose-lg max-w-none">
              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۱. اطلاعاتی که جمع‌آوری می‌کنیم</h2>
              <p class="text-gray-700 mb-4">
                ممکن است اطلاعات شخصی را که به طور داوطلبانه به ما ارائه می‌دهید جمع‌آوری کنیم زمانی که شما:
              </p>
              <ul class="list-disc pr-8 mb-6 text-gray-700" dir="rtl">
                <li>برای یک حساب کاربری ثبت‌نام می‌کنید</li>
                <li>در خبرنامه ما مشترک می‌شوید</li>
                <li>از طریق ایمیل یا فرم‌های تماس با ما تماس می‌گیرید</li>
                <li>در نظرسنجی‌ها یا بازخورد شرکت می‌کنید</li>
              </ul>
              <p class="text-gray-700 mb-6">
                اطلاعات شخصی که جمع‌آوری می‌کنیم ممکن است شامل نام، آدرس ایمیل و هر اطلاعات دیگری باشد که انتخاب می‌کنید ارائه دهید.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۲. نحوه استفاده ما از اطلاعات شما</h2>
              <p class="text-gray-700 mb-4">
                ممکن است از اطلاعاتی که جمع‌آوری می‌کنیم برای اهداف مختلفی استفاده کنیم، از جمله:
              </p>
              <ul class="list-disc pr-8 mb-6 text-gray-700" dir="rtl">
                <li>برای ارائه و حفظ سرویس ما</li>
                <li>برای اطلاع شما از تغییرات در سرویس ما</li>
                <li>برای امکان شرکت شما در ویژگی‌های تعاملی</li>
                <li>برای ارائه پشتیبانی مشتری</li>
                <li>برای جمع‌آوری تحلیل یا اطلاعات ارزشمند برای بهبود سرویس ما</li>
                <li>برای نظارت بر استفاده از سرویس ما</li>
                <li>برای شناسایی، جلوگیری و رسیدگی به مسائل فنی</li>
              </ul>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۳. اشتراک‌گذاری اطلاعات</h2>
              <p class="text-gray-700 mb-6">
                ما اطلاعات شخصی شما را بدون رضایت شما به فروش نمی‌رسانیم، معامله نمی‌کنیم یا به صورت دیگر به اشخاص ثالث منتقل نمی‌کنیم. این شامل اشخاص ثالث مورد اعتمادی نمی‌شود که به ما در اداره وب‌سایت، انجام کار ما یا خدمت به کاربران ما کمک می‌کنند، به شرطی که آن اشخاص موافقت کنند این اطلاعات را محرمانه نگه دارند.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۴. کوکی‌ها و فناوری‌های ردیابی</h2>
              <p class="text-gray-700 mb-6">
                ممکن است از کوکی‌ها و فناوری‌های ردیابی مشابه برای ردیابی فعالیت در سرویس ما و ذخیره اطلاعات خاصی استفاده کنیم. می‌توانید به مرورگر خود دستور دهید که تمام کوکی‌ها را رد کند یا هنگام ارسال کوکی اطلاع دهد. با این حال، اگر کوکی‌ها را نپذیرید، ممکن است نتوانید از برخی قسمت‌های سرویس ما استفاده کنید.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۵. امنیت داده‌ها</h2>
              <p class="text-gray-700 mb-6">
                ما اقدامات امنیتی مناسب را برای محافظت در برابر دسترسی غیرمجاز، تغییر، افشای اطلاعات یا تخریب اطلاعات شخصی شما اجرا می‌کنیم. با این حال، هیچ روش انتقال از طریق اینترنت یا روش ذخیره‌سازی الکترونیکی ۱۰۰٪ امن نیست و ما نمی‌توانیم امنیت مطلق را تضمین کنیم.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۶. نگهداری داده‌ها</h2>
              <p class="text-gray-700 mb-6">
                ما اطلاعات شخصی شما را فقط تا زمانی که برای اهداف مشخص شده در این سیاست حفظ حریم خصوصی لازم است نگه می‌داریم. ما اطلاعات شما را نگه می‌داریم و استفاده می‌کنیم تا حدی که برای رعایت تعهدات قانونی، حل اختلافات و اجرای سیاست‌های ما لازم است.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۷. حقوق شما</h2>
              <p class="text-gray-700 mb-6">
                شما حق دسترسی، به‌روزرسانی یا حذف اطلاعات شخصی‌ای که در مورد شما داریم را دارید. می‌توانید با تماس مستقیم با ما این کار را انجام دهید. شما همچنین حق شکایت به یک مقام حفاظت از داده در مورد جمع‌آوری و استفاده ما از اطلاعات شخصی شما را دارید.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۸. حریم خصوصی کودکان</h2>
              <p class="text-gray-700 mb-6">
                سرویس ما به هیچ کس زیر ۱۳ سال آدرس داده نمی‌شود. ما به طور آگاهانه اطلاعات قابل شناسایی شخصی را از کودکان زیر ۱۳ سال جمع‌آوری نمی‌کنیم. اگر متوجه شویم که کودکی زیر ۱۳ سال اطلاعات شخصی را به ما ارائه کرده است، بلافاصله این اطلاعات را از سرورهای خود حذف خواهیم کرد.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۹. تغییرات در این سیاست حفظ حریم خصوصی</h2>
              <p class="text-gray-700 mb-6">
                ممکن است سیاست حفظ حریم خصوصی خود را از وقتی به وقت به‌روز کنیم. از طریق انتشار سیاست حفظ حریم خصوصی جدید در این صفحه و به‌روزرسانی تاریخ "آخرین به‌روزرسانی" شما را از هر تغییری مطلع خواهیم کرد.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۱۰. تماس با ما</h2>
              <p class="text-gray-700 mb-6">
                اگر سؤالی در مورد این سیاست حفظ حریم خصوصی دارید، لطفاً با ما از طریق ایمیل privacy@astrolab.example.com تماس بگیرید.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>