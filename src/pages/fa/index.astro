---
// src/pages/fa/index.astro
import MainLayout from '@layouts/MainLayout.astro';
import Testimonials from '@components/Testimonials.astro';
import NewsletterSignup from '@components/NewsletterSignup.astro';
import Statistics from '@components/Statistics.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';
import { Image } from 'astro:assets';

// Import images directly
import heroImage from '@public/images/8.jpg';
import hamdelImage from '@public/images/1.jpg';
import hammasirImage from '@public/images/6.png';
import hampayeMadarImage from '@public/images/4.jpg';
import bahamImage from '@public/images/7.jpg';
import darmanaImage from '@public/images/2.jpg';
import kanapeImage from '@public/images/3.jpg';
import synapseImage from '@public/images/11.jpg';
import khebrehImage from '@public/images/10.jpg';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);
---

<MainLayout title="ذهنا - نرم افزار روان‌شناسی هوش مصنوعی با قابلیت توسعه راهکارهای سفارشی" lang={lang} dir={dir}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#3CAC88] via-[#99D2B4] to-[#3CAC88] text-white mb-20 shadow-2xl">
    <div class="absolute inset-0 bg-[url('/pattern.svg')] bg-repeat opacity-5"></div>
    <!-- Enhanced animated background elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden">
      <div class="absolute -top-40 -left-40 w-80 h-80 bg-[#3CAC88] rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
      <div class="absolute -bottom-40 -right-40 w-80 h-80 bg-[#99D2B4] rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-60 h-60 bg-[#5AC5A0] rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-1000"></div>
    </div>
    <div class="relative container mx-auto px-4 lg:pr-12 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="text-center lg:text-right">
          <div class="flex items-center justify-center lg:justify-start mb-6">
            <div class="w-15 h-15 rounded-full bg-white flex items-center justify-center mx-4 shadow-xl">
              <img src="/images/logo.svg" alt="نشان ذهنا" class="w-16 h-16" />
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-['Cinzel'] font-extrabold leading-tight tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-white/80 rtl:lg:text-right ltr:lg:text-left">
              ذهنا
            </h1>
          </div>
          <p class="text-xl md:text-2xl text-white/90 mb-6 max-w-2xl mx-auto lg:mx-0">
            نرم افزار روان‌شناسی هوش مصنوعی برای زندگی بهتر
          </p>
          <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto lg:mx-0">
            مجموعه‌ای جامع از ابزارهای هوش مصنوعی برای حمایت عاطفی، روابط، والدین، سلامت روان و بیشتر - با قابلیت توسعه راهکارهای سفارشی برای نیازهای خاص شما
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-end">
            <a href="https://panel.zehna.ir" class="bg-white text-[#3CAC88] font-bold px-8 py-4 rounded-xl hover:bg-gray-100 transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 relative overflow-hidden group inline-flex items-center justify-center">
              <span class="relative z-10 dark:text-black">شروع کار</span>
              <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-right"></div>
            </a>
            <button class="bg-gradient-to-r from-primary to-secondary text-white font-bold px-8 py-4 rounded-xl hover:from-primary-dark hover:to-secondary-dark transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 relative overflow-hidden group">
              <span class="relative z-10">اطلاعات بیشتر</span>
              <div class="absolute inset-0 bg-gradient-to-r from-white/10 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-right"></div>
            </button>
          </div>
        </div>
        <div class="flex justify-center">
          <div class="relative">
            <!-- Enhanced floating animation elements -->
            <div class="absolute -top-8 -left-8 w-40 h-40 bg-[#3CAC88] rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob"></div>
            <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-[#99D2B4] rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-2000"></div>
            <div class="relative rounded-3xl overflow-hidden border-8 border-white/20 shadow-2xl transform rotate-3 hover:rotate-0 transition-transform duration-700">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-secondary/20"></div>
              <Image 
                src={heroImage} 
                alt="ذهنا" 
                class="w-full h-auto object-cover relative z-10"
                width={600} 
                height={400}
                format="webp"
                loading="lazy"
              />
              <!-- Decorative elements -->
              <div class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-lg">
                <img src="/images/logo.svg" alt="نشان ذهنا" class="w-6 h-6" />
              </div>
              <!-- Floating elements -->
              <div class="absolute bottom-6 left-6 w-8 h-8 rounded-full bg-white/30 backdrop-blur-sm flex items-center justify-center animate-pulse shadow-lg">
                <div class="w-2 h-2 rounded-full bg-white"></div>
              </div>
              <div class="absolute top-1/3 left-1/4 w-6 h-6 rounded-full bg-[#99D2B4]/40 backdrop-blur-sm flex items-center justify-center animate-ping shadow-lg">
                <div class="w-1 h-1 rounded-full bg-white"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Decorative stars -->
    <div class="absolute top-10 left-10 w-2 h-2 rounded-full bg-white animate-pulse"></div>
    <div class="absolute top-20 right-20 w-1 h-1 rounded-full bg-white animate-pulse animation-delay-1000"></div>
    <div class="absolute bottom-20 left-1/3 w-1.5 h-1.5 rounded-full bg-white animate-pulse animation-delay-2000"></div>
    <div class="absolute bottom-10 right-10 w-2 h-2 rounded-full bg-white animate-pulse animation-delay-500"></div>
  </section>

  <!-- About Zehna Section -->
  <section class="py-16 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-3xl mb-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center mb-6">
          <div class="w-16 h-16 rounded-full bg-white dark:bg-gray-800 flex items-center justify-center mx-4 shadow-lg">
            <img src="/images/logo.svg" alt="نشان ذهنا" class="w-12 h-12" />
          </div>
          <h2 class="text-3xl md:text-4xl font-['Cinzel'] font-bold text-gray-900 dark:text-white">ذهنا چیست؟</h2>
        </div>
        <p class="text-xl text-gray-700 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
          ذهنا یک نرم افزار روان‌شناسی هوش مصنوعی است که ترکیبی از حکمت روان‌شناسی مدرن و قدرت هوش مصنوعی را فراهم می‌کند تا ابزارهای دقیق و بینش‌گری برای بهبود زندگی روزمره شما ارائه دهد. اولین پلتفرم جامع سلامت روان در ایران است که بینش‌های روان‌شناسی را با فناوری مدرن ترکیب می‌کند.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">حمایت عاطفی</h3>
            <p class="text-gray-600 dark:text-gray-400">
              دسترسی ۲۴/۷ به حمایت عاطفی هوش مصنوعی برای کمک در مواقع بحران و استرس با رویکردهای علمی.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">روابط</h3>
            <p class="text-gray-600 dark:text-gray-400">
              بهبود روابط عاشقانه و زناشویی با ابزارهای تخصصی برای درک بهتر و همسان‌سازی علمی.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">رشد شخصی</h3>
            <p class="text-gray-600 dark:text-gray-400">
              ابزارهای رشد شخصی برای تقویت مهارت‌های زندگی، مدیریت استرس و بهبود سلامت روان با بینش‌های هوش مصنوعی.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">حمایت از والدین</h3>
            <p class="text-gray-600 dark:text-gray-400">
              حمایت جامع از مادران و والدین در تربیت فرزندان با کمک هوش مصنوعی و نظارت روانشناس انسانی.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">بهبود اعتیاد</h3>
            <p class="text-gray-600 dark:text-gray-400">
              سیستم‌های نظارت و حمایت هوشمند برای بهبود اعتیاد با پتانسیل کاهش عود تا ۴۰٪.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">جامعه و بحران</h3>
            <p class="text-gray-600 dark:text-gray-400">
              قابلیت‌های مداخله بحران ۲۴/۷ با تشخیص هوشمند موقعیت‌های بحرانی و حمایت فوری.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">استخدام و منابع انسانی</h3>
            <p class="text-gray-600 dark:text-gray-400">
              کمک هوش مصنوعی برای منابع انسانی شامل استخدام هوشمند، بهینه‌سازی تیم و سازگاری فرهنگی.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">بینش داده‌ها</h3>
            <p class="text-gray-600 dark:text-gray-400">
              تحلیل پیشرفته الگوهای رفتاری و بینش‌های روان‌شناختی برای پژوهشگران و متخصصان.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">راهکارهای سفارشی</h3>
            <p class="text-gray-600 dark:text-gray-400">
              راهکارهای روان‌شناختی هوش مصنوعی سفارشی برای سازمان‌ها، پژوهشگران و کاربردهای خاص با انطباق کامل.
            </p>
          </div>
        </div>
        
        <div class="mt-12 bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">ماموریت ما</h3>
            <div class="w-20 h-1 bg-gradient-to-r from-[#3CAC88] to-[#99D2B4] mx-auto rounded-full"></div>
          </div>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column -->
            <div class="space-y-6">
              <div class="bg-gradient-to-br from-[#3CAC88]/20 to-[#99D2B4]/20 dark:from-[#3CAC88]/20 dark:to-[#99D2B4]/20 p-6 rounded-xl border border-[#3CAC88]/20 dark:border-[#3CAC88]/30">
                <h4 class="font-bold text-lg text-[#3CAC88] dark:text-[#99D2B4] mb-3 flex items-center">
                  <svg class="w-5 h-5 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  ماموریت اصلی
                </h4>
                <p class="text-gray-700 dark:text-gray-300 mb-4">
                  ذهنا تلاش دارد تا دسترسی به ابزارهای روان‌شناسی با کیفیت بالا را برای همه، صرف‌نظر از سطح درآمد یا موقعیت جغرافیایی، فراهم کند. ما با ارائه راهکارهای مقرون به صرفه و انطباق فرهنگی، شکاف حیاتی در خدمات سلامت روان در ایران را پر می‌کنیم.
                </p>
                <div class="bg-white dark:bg-gray-700/50 p-4 rounded-lg border border-[#3CAC88]/20 dark:border-[#99D2B4]/30">
                  <p class="text-gray-700 dark:text-gray-300 italic text-sm">
                    "با ترکیب قدرت هوش مصنوعی با رویکردهای علمی روان‌شناسی، ما یک پل بین دانش روان‌شناسی مدرن و نیازهای روزمره انسان‌ها ایجاد می‌کنیم که به افراد امکان می‌دهد با اطمینان مسیر زندگی خود را شکل دهند."
                  </p>
                </div>
              </div>
              
              <div class="bg-gradient-to-br from-cyan-50 to-blue-50 dark:from-cyan-900/20 dark:to-blue-900/20 p-6 rounded-xl border border-cyan-100 dark:border-cyan-900/30">
                <h4 class="font-bold text-lg text-cyan-800 dark:text-cyan-200 mb-3 flex items-center">
                  <svg class="w-5 h-5 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  تمایزات کلیدی
                </h4>
                <ul class="space-y-2 text-gray-700 dark:text-gray-300">
                  <li class="flex items-start">
                    <span class="text-cyan-500 mx-2">✓</span>
                    <span>مبتنی بر استانداردهای علمی روان‌شناسی (DSM-5، PDM-2)</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-cyan-500 mx-2">✓</span>
