                </a>
                <a 
                  href={lang === "en" ? "/team" : `/${lang}/team`} 
                  class={`block px-4 py-2 text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 dark:text-gray-200 dark:hover:text-white dark:hover:bg-gray-700 ${Astro.url.pathname.startsWith(lang === "en" ? "/team" : `/${lang}/team`) ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200" : ""}`}
                >
