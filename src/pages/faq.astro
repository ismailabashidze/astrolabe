---
// src/pages/faq.astro
import MainLayout from '../layouts/MainLayout.astro';
import { getTranslation, isRTL } from '../utils/i18n.js';

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// FAQ data
const faqCategories = [
  {
    category: "General Questions",
    questions: [
      {
        question: "What is Zehna?",
        answer: "Zehna is a psychological AI super app that provides comprehensive services in the field of mental health and human relationships. We combine advanced artificial intelligence technology with clinical psychology knowledge to offer innovative solutions for improving quality of life. Zehna aims to bridge the gap between human psychological needs and access to specialized psychological services, especially for underserved populations and in crisis situations."
      },
      {
        question: "What products does Zehna offer?",
        answer: "Zehna includes several specialized products: Hamdel (24/7 emotional support), Hammasir (marriage counseling and scientific matchmaking), HamPay-e Madar (support for mothers and children), Baham (resource sharing platform), Darmana (psychological diagnosis based on DSM-5 and PDM-2), Kanape (learning psychological skills through role-playing), Synapse (AI for human resources), and Khebreh (news and social insights platform). Each product addresses a specific aspect of psychological and social life and is designed according to up-to-date scientific and psychological standards."
      },
      {
        question: "Is Zehna free to use?",
        answer: "Zehna follows a freemium model. Some basic services are free, but you'll need a subscription to access advanced products and specialized services. We offer various plans for individuals, families, and organizations. Special programs are also available for underserved groups to ensure equitable access to psychological services."
      },
      {
        question: "What makes Zehna different from other psychology apps?",
        answer: "Zehna offers a personalized yet scientific experience by combining advanced AI with clinical psychology knowledge. Additionally, by focusing on localization and cultural relevance, we provide solutions that align with Iranian culture and Islamic values. Zehna also strives to create a comprehensive and integrated platform by offering services in various aspects of life (from child-rearing to marital relationships and human resources)."
      }
    ]
  },
  {
    category: "Technical Support",
    questions: [
      {
        question: "What browsers does Zehna support?",
        answer: "Zehna works on all modern browsers including Chrome, Firefox, Safari, and Edge. We recommend using the latest version of your preferred browser for the best experience. Dedicated apps for iOS and Android are also available for download from their respective stores."
      },
      {
        question: "Can I use Zehna on my mobile device?",
        answer: "Yes, Zehna is fully responsive and works great on smartphones and tablets. Our mobile experience is optimized for touch interaction and smaller screens. We also have dedicated apps for iOS and Android that offer more products than the web version."
      },
      {
        question: "How do I report a bug or technical issue?",
        answer: "You can report bugs or technical issues through our contact page or by emailing support@zehna.ir. Please include details about your device, browser, and steps to reproduce the issue. In the mobile apps, the bug reporting section is available in settings. Our technical team is available 24/7."
      },
      {
        question: "Is Zehna regularly updated?",
        answer: "Yes, Zehna is continuously updated. We release weekly security and performance updates and regularly add new products. All updates are automatic and don't require user action."
      }
    ]
  },
  {
    category: "Account & Billing",
    questions: [
      {
        question: "How do I create an account?",
        answer: "You can create an account by clicking the 'Sign Up' button in the top right corner of our website. You'll need to provide your email address and create a password. You can also sign in through social networks or your mobile phone number. The registration process takes less than a minute."
      },
      {
        question: "Can I change or cancel my subscription?",
        answer: "Yes, you can upgrade, downgrade, or cancel your subscription at any time from your account settings. Changes take effect immediately, and we offer a 30-day money-back guarantee for all paid plans. If you cancel your subscription, your access will remain active until the end of the paid period."
      },
      {
        question: "What payment methods do you accept?",
        answer: "We accept all major credit cards including Visa, Mastercard, and American Express. We also support PayPal, electronic wallets, and bank transfers for annual subscriptions. For Iranian users, local payment gateways are also available."
      },
      {
        question: "Do you offer discounts for students?",
        answer: "Yes, we have special discount codes for students and educational institutions. We've also designed special educational programs for learning centers. Contact us through our contact page to receive discounts."
      }
    ]
  },
  {
    category: "Psychology Questions",
    questions: [
      {
        question: "Is Zehna's AI a replacement for psychological counseling?",
        answer: "No, Zehna's AI is not a replacement for in-person psychological counseling, but rather a complement to it. Zehna's AI is designed for daily support, providing initial solutions and teaching self-management skills. For more complex issues and specialized diagnoses, our products like Darmana provide access to human specialists."
      },
      {
        question: "Is my information secure in Zehna?",
        answer: "Yes, protecting user privacy and information security is our top priority. All data is encrypted and stored on secure domestic servers. We follow international security standards and are committed to complying with data protection laws. None of your personal information is shared with third parties."
      },
      {
        question: "Do you offer psychological counseling?",
        answer: "In some of our products like HamPay-e Madar and Hammasir, human psychologists are active and provide specialized counseling. You can also connect with specialists through Darmana. Human counseling is available through chat, voice, and video calls, and prices are set based on each psychologist's expertise and experience."
      },
      {
        question: "Can Zehna help prevent suicide?",
        answer: "Yes, suicide prevention is one of Zehna's key goals. Our system can identify warning signs using advanced algorithms and immediately intervene. In crisis situations, we provide immediate access to crisis intervention specialists. We collaborate with relevant organizations to ensure these services are delivered effectively."
      }
    ]
  }
];
---

<MainLayout title="Frequently Asked Questions - Zehna" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-4">Frequently Asked Questions</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Find answers to common questions about Zehna and psychological services
        </p>
      </div>
      
      <div x-data="faqAccordion()" class="max-w-4xl mx-auto">
        <template x-for="(category, catIndex) in faqCategories" :key="catIndex">
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700" x-text="category.category"></h2>
            <div class="space-y-6">
              <template x-for="(faq, index) in category.questions" :key="index">
                <div class="bg-white dark:bg-gray-700 rounded-xl shadow-md border border-gray-100 dark:border-gray-600 overflow-hidden">
                  <div @click="toggle(catIndex + '_' + index)" class="faq-question flex justify-between items-center p-6 cursor-pointer">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white" x-text="faq.question"></h3>
                    <svg class="w-5 h-5 text-gray-500 dark:text-gray-300 transform transition-transform duration-200" :class="{ 'rotate-180': openIndex === catIndex + '_' + index }" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <div x-show="openIndex === catIndex + '_' + index" x-transition class="faq-answer px-6 pb-6">
                    <p class="text-gray-600 dark:text-gray-200" x-text="faq.answer"></p>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
      
      <div class="bg-gradient-to-r from-primary to-secondary rounded-2xl p-8 md:p-12 text-white mt-16">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">Still Have Questions?</h2>
          <p class="text-xl text-indigo-100 mb-8">
            Can't find the answer you're looking for? Our support team is here to help.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
              Contact Support
            </a>
            <a href="/community" class="bg-transparent border-2 border-white text-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-colors duration-300">
              Join Community
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
