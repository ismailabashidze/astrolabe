---
// src/pages/fa/features.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';
import { Image } from 'astro:assets';

// Import images
import hamdelImage from '@public/images/1.jpg';
import hammasirImage from '@public/images/6.png';
import hampayeMadarImage from '@public/images/4.jpg';
import bahamImage from '@public/images/7.jpg';
import darmanaImage from '@public/images/2.jpg';
import kanapeImage from '@public/images/3.jpg';
import synapseImage from '@public/images/11.jpg';
import khebrehImage from '@public/images/10.jpg';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);
---
<MainLayout title="محصولات ذهنا" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6">محصولات ذهنا</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          مجموعه جامع ابزارهای هوش مصنوعی برای هر جنبه از زندگی روانی و اجتماعی شما
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <!-- Hamdel -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-red-50 dark:bg-gray-700 flex items-center justify-center mb-5">
            <span class="text-2xl">❤️</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">همدل</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            هوش مصنوعی برای حمایت عاطفی و روانی در مواقع بحران و استرس
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={hamdelImage} 
              alt="همدل" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>حمایت ۲۴/۷ در مواقع بحران</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>تشخیص احساسات و هیجانات</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>تکنیک‌های مدیریت استرس</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>تشخیص الگوهای رفتاری ناسازگار</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>ارائه راهکارهای شخصی‌سازی‌شده</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>پیگیری پیشرفت روانی کاربر</span>
            </li>
          </ul>
          <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <h4 class="font-bold text-blue-800 dark:text-blue-200 mb-2">محصولات کلیدی</h4>
            <p class="text-blue-700 dark:text-blue-300 text-sm">
              همدل با استفاده از الگوریتم‌های پیشرفته هوش مصنوعی، ۲۴ ساعته و ۷ روز هفته آماده ارائه حمایت عاطفی است. این سیستم می‌تواند الگوهای رفتاری و احساسی کاربر را تشخیص داده و راهکارهای شخصی‌سازی‌شده ارائه دهد. با قابلیت‌های یادگیری ماشین، همدل به طور مداوم درک خود از پروفایل روانی هر کاربر را بهبود می‌بخشد.
            </p>
          </div>
          <div class="mt-4 flex gap-3">
            <a href="#" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              مشاهده پروژه
            </a>
            <a href="/fa/hamdel" class="inline-block bg-white hover:bg-gray-100 text-blue-600 border border-blue-600 font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              جزئیات بیشتر
            </a>
          </div>
        </div>
        
        <!-- Hammasir -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl">💍</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">هم‌مسیر</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            هوش مصنوعی و حمایت روانشناس برای روابط عاشقانه، ازدواج و همسان‌سازی
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={hammasirImage} 
              alt="هم‌مسیر" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>تحلیل سازگاری زناشویی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>حل تعارضات روابطی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>همسان‌سازی علمی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>ارزیابی شخصیت و ارزش‌های زندگی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>آموزش مهارت‌های ارتباط مؤثر</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>مشاوره پیش از ازدواج</span>
            </li>
          </ul>
          <div class="mt-6 p-4 bg-green-50 dark:bg-green-900/20 rounded-lg">
            <h4 class="font-bold text-green-800 dark:text-green-200 mb-2">مزایای کلیدی</h4>
            <p class="text-green-700 dark:text-green-300 text-sm">
              هم‌مسیر با ترکیب هوش مصنوعی و تخصص روانشناسی، فرآیند آشنایی و ازدواج را به یک مسیر ساختارمند و علمی تبدیل می‌کند. این سیستم به جای تمرکز صرف بر جذابیت بیرونی، بر سازگاری عمیق روانی و ارزشی تأکید دارد. این پلتفرم شامل ماژول‌های مشاوره پیش از ازدواج و ابزارهای پشتیبانی از رابطه برای اطمینان از موفقیت بلندمدت است.
            </p>
          </div>
          <div class="mt-4 flex gap-3">
            <a href="#" class="inline-block bg-[#3CAC88] hover:bg-[#99D2B4] text-white font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              مشاهده پروژه
            </a>
            <a href="/fa/hammasir" class="inline-block bg-white hover:bg-gray-100 text-[#3CAC88] border border-[#3CAC88] font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              جزئیات بیشتر
            </a>
          </div>
        </div>
        
        <!-- TogetherMama (TogetherMama) -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl">🤱</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">هم‌پای مادر</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            هوش مصنوعی و حمایت روانشناس برای والدین و پرورش فرزندان
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={hampayeMadarImage} 
              alt="هم‌پای مادر" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>راهنمایی در پرورش فرزندان</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>حل چالش‌های والدینی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>حمایت روانی برای مادران</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>غربالگری اولیه مشکلات رشدی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>ارائه برنامه‌های شخصی‌سازی‌شده</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>پیگیری پیشرفت کودک و مادر</span>
            </li>
          </ul>
          <div class="mt-6 p-4 bg-pink-50 dark:bg-pink-900/20 rounded-lg">
            <h4 class="font-bold text-pink-800 dark:text-pink-200 mb-2">مزایای منحصربه‌فرد</h4>
            <p class="text-pink-700 dark:text-pink-300 text-sm">
              هم‌پای مادر با ترکیب هوش مصنوعی ۲۴/۷ و حمایت روانشناس انسانی، مادران را در مسیر پرورش کودکان خود همراهی می‌کند. این سیستم می‌تواند مشکلات رشدی کودک را در مراحل اولیه شناسایی کرده و راهکارهای عملی ارائه دهد. این پلتفرم همچنین ابزارهای پشتیبانی اجتماعی ارائه می‌دهد که والدین می‌توانند با دیگران با چالش‌های مشابه ارتباط برقرار کنند و یک شبکه حمایتی بسازند.
            </p>
          </div>
          <div class="mt-4 flex gap-3">
            <a href="#" class="inline-block bg-pink-600 hover:bg-pink-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              مشاهده پروژه
            </a>
            <a href="/fa/hampaye-madar" class="inline-block bg-white hover:bg-gray-100 text-pink-600 border border-pink-600 font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              جزئیات بیشتر
            </a>
          </div>
        </div>
        
        <!-- Baham -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl">🛒</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">با هم</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            پلتفرم برای خرید گروهی و کاهش هزینه‌های روزمره
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={bahamImage} 
              alt="با هم" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>خرید گروهی کالاها</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>کاهش هزینه‌های زندگی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>شبکه اجتماعی خریداران</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>تحلیل الگوهای مصرفی</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>پیشنهادات شخصی‌سازی‌شده</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>مدیریت بودجه خانوادگی</span>
            </li>
          </ul>
          <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <h4 class="font-bold text-blue-800 dark:text-blue-200 mb-2">مزایای اقتصادی</h4>
            <p class="text-blue-700 dark:text-blue-300 text-sm">
              با هم با ایجاد شبکه خریداران، قدرت مذاکره جمعی را برای کاهش قیمت کالاها به کار می‌گیرد. این پلتفرم می‌تواند الگوهای مصرفی کاربران را تحلیل کرده و پیشنهادات شخصی‌سازی‌شده ارائه دهد. با ابزارهایی مانند ردیابی قیمت و هشدارهای پیشنهاد، کاربران می‌توانند حداکثر صرفه‌جویی را داشته باشند.
            </p>
          </div>
          <div class="mt-4 flex gap-3">
            <a href="#" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              مشاهده پروژه
            </a>
            <a href="/fa/baham" class="inline-block bg-white hover:bg-gray-100 text-blue-600 border border-blue-600 font-medium py-2 px-4 rounded-lg transition-colors duration-300">
              جزئیات بیشتر
            </a>
          </div>
        </div>
        
        <!-- Darmana -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 rounded-full bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl">🏥</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">درمانا</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            هوش مصنوعی برای تشخیص روان‌شناسی بر اساس DSM-5 و PDM-2
          </p>
          <div class="rounded-lg overflow-hidden mb-4">
            <Image 
              src={darmanaImage} 
              alt="درمانا" 
              class="w-full h-auto object-cover"
              width={400} 
              height={250}
              format="webp"
              loading="lazy"
            />
          </div>
          <ul class="text-gray-600 dark:text-gray-300 space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
