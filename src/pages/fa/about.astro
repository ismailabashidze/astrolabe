---
// src/pages/fa/about.astro
import MainLayout from '@layouts/MainLayout.astro';
import Testimonials from '@components/Testimonials.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';
import image17 from '@public/images/17.jpg';
import { Image } from 'astro:assets';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Team members data based on docs
const teamMembers = [
  {
    name: "دکتر هادی بهرامی احسان",
    role: "بنیانگذار و مدیرعامل",
    bio: "استاد تمام دانشگاه تهران، رهبری توسعه ذهنا به عنوان یک پلتفرم ملی سلامت روان دیجیتال.",
    avatar: "HB"
  },
  {
    name: "علی بهرامی احسان",
    role: "مدیر فناوری",
    bio: "مدیر تیم نوآوری فناوری در ذهنا، مسئول توسعه زیرساخت هوش مصنوعی و پلتفرم دیجیتال.",
    avatar: "KK"
  },
  {
    name: "تیم روانشناسی هوش مصنوعی",
    role: "متخصصان روانشناسی بالینی",
    bio: "متخصصان در CBT، DBT، ACT، تمرکز و درمان بین فردی که نظارت بر مدل‌های هوش مصنوعی ما را بر عهده دارند.",
    avatar: "AP"
  },
  {
    name: "تیم توسعه",
    role: "مهندسان هوش مصنوعی و نرم‌افزار",
    bio: "متخصصان در هوش مصنوعی، یادگیری ماشین و توسعه نرم‌افزار کامل که پلتفرم‌های ما را می‌سازند.",
    avatar: "DT"
  }
];
---

<MainLayout title="درباره ذهنا" lang={lang} dir={dir}>
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-light via-secondary-light to-pink-50 pattern-bg"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">درباره ذهنا</h1>
        <p class="text-xl md:text-2xl text-gray-700 max-w-2xl mx-auto mb-8">
          اولین پلتفرم سلامت روان مبتنی بر هوش مصنوعی ایران
        </p>
        <!-- Hero Image -->
        <div class="mt-8 rounded-xl overflow-hidden shadow-lg">
          <Image 
            src={image17} 
            alt="روانشناسی" 
            class="w-full h-auto object-cover"
            width="1200" 
            height="400"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="card">
          <div class="card-content">
            <div class="prose prose-lg max-w-none">
              <p class="text-lg text-gray-700 dark:text-gray-300 mb-8">
                ذهنا اولین پلتفرم سلامت روان مبتنی بر هوش مصنوعی ایران است که حکمت روانشناسی مدرن را با هوش مصنوعی ترکیب می کند تا ابزارهای دقیق و بینش گری برای بهبود زندگی روزمره شما فراهم کند. به عنوان یک ابتکار ملی، ما متعهد به دسترسی همه ایرانیان به خدمات سلامت روان با کیفیت بالا هستیم، صرف نظر از موقعیت جغرافیایی یا وضعیت اقتصادی آنها.
              </p>
              
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-12 mb-6">ماموریت ما</h2>
              <p class="text-gray-700 dark:text-gray-300 mb-6">
                ماموریت ذهنا ارائه پشتیبانی سلامت روان قابل دسترس، ایمن و مداوم با ترکیب هوش مصنوعی و روانشناسی بالینی است. ما در تلاشیم تا با پلتفرم دیجیتال خود، شکاف موجود در خدمات روانشناسی در ایران را پر کنیم و در عین حال از حریم خصوصی داده ها و ارتباط فرهنگی آنها محافظت کنیم.
              </p>
              
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-12 mb-6">ارزش های ما</h2>
              <ul class="list-disc pl-6 text-gray-700 dark:text-gray-300 mb-6">
                <li class="mb-2 mx-5"><strong>همدلی واقعی:</strong> طراحی سیستم های هوش مصنوعی که با کاربران به صورت انسانی، مهربانانه و بدون قضاوت تعامل دارند.</li>
                <li class="mb-2 mx-5"><strong>حریم خصوصی کامل:</strong> تمام داده های کاربران با استانداردهای امنیتی بالا محافظت شده، رمزگذاری شده و به طور دقیق از سیاست های حریم خصوصی پیروی می کنند.</li>
                <li class="mb-2 mx-5"><strong>دسترسی برای همه:</strong> حذف موانع زمانی، مکانی و مالی برای دسترسی به خدمات سلامت روان.</li>
                <li class="mb-2 mx-5"><strong>نوآوری مداوم:</strong> به روزرسانی مداوم زیرساخت هوش مصنوعی ما و افزودن قابلیت های درمانی پیشرفته تر.</li>
                <li class="mb-2 mx-5"><strong>یادگیری از کاربران:</strong> استفاده از بازخورد کاربران برای بهبود مداوم کیفیت خدمات.</li>
                <li class="mb-2 mx-5"><strong>جامعه حمایتی:</strong> ایجاد محیطی امن برای تعاملات کاربران، به اشتراک گذاری تجربیات و حمایت متقابل.</li>
              </ul>
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-10">
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 text-center">
                  <div class="w-16 h-16 rounded-full bg-indigo-500 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">دقت</h3>
                  <p class="text-gray-600 dark:text-gray-300">محاسبات دقیق بر اساس داده‌های روان‌شناسی و هوش مصنوعی</p>
                </div>
                
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 text-center">
                  <div class="w-16 h-16 rounded-full bg-purple-500 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">جامعه</h3>
                  <p class="text-gray-600 dark:text-gray-300">ایجاد ارتباطات میان علاقه‌مندان به روان‌شناسی</p>
                </div>
                
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 text-center">
                  <div class="w-16 h-16 rounded-full bg-pink-500 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">آموزش</h3>
                  <p class="text-gray-600 dark:text-gray-300">کمک به کاربران برای درک مفاهیم روان‌شناسی</p>
                </div>
              </div>
              
              
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6">نوآوری و فناوری</h2>
              <p class="text-gray-700 dark:text-gray-300 mb-6">
                ذهنا اولین پلتفرم سلامت روان مبتنی بر هوش مصنوعی ایران است که حکمت روانشناسی مدرن را با هوش مصنوعی ترکیب می کند تا ابزارهای دقیق و بینش گری برای بهبود زندگی روزمره فراهم کند. جلسات درمانی مبتنی بر هوش مصنوعی ما ۲۴/۷ پشتیبانی با استفاده از رویکردهای علمی ارائه می دهند که شامل درمان رفتار شناختی (CBT)، درمان رفتار دیالکتیک (DBT)، درمان پذیرش و تعهد (ACT)، تمرکز، درمان بین فردی و درمان متمرکز بر همدلی است.
              </p>
              
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6">فرهنگ ما</h2>
              <p class="text-gray-700 dark:text-gray-300 mb-6">
                در ذهنا، ما فرهنگی از مسئولیت اجتماعی و نوآوری جهت گیرانه عدالت را پرورش می دهیم. تیم ما متعهد به پر کردن شکاف موجود در خدمات سلامت روان در ایران با توسعه راه حل های دیجیتال فرهنگی، ایمن و قابل دسترس است. ما اولویت می دهیم:
              </p>
              <ul class="list-disc pl-6 text-gray-700 dark:text-gray-300 mb-6">
                <li class="mb-2 mx-5">استقلال از زیرساخت های محلی برای اطمینان از ادامه خدمات حتی در مواقع اضطراری</li>
                <li class="mb-2 mx-5">هماهنگی فرهنگی و مذهبی با ارزش های ایرانی-اسلامی</li>
                <li class="mb-2 mx-5">ذخیره ایمن داده های حساس کاربران در سرورهای داخلی</li>
                <li class="mb-2 mx-5">پر کردن شکاف موجود در خدمات روانشناسی در سطوح اقتصادی-اجتماعی مختلف</li>
              </ul>
              
              <div class="mt-8">
                <p class="text-gray-700 dark:text-gray-300">
                  برای اطلاعات بیشتر درباره پروژه ها و ابتکارات ما، لطفاً مستقیماً با ما تماس بگیرید.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-16 bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-gray-900">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 dark:text-white mb-4">رهبران و متخصصان ما</h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          متخصصان متعهد که تحول دیجیتال سلامت روان ایران را هدایت می کنند
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {teamMembers.map((member, index) => (
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700 text-center">
            <div class="relative mx-auto mb-6">
                <div class="w-24 h-24 rounded-full bg-gradient-to-r from-primary to-secondary flex items-center justify-center mx-auto">
                  <span class="text-2xl font-bold text-white">{member.avatar}</span>
                </div>
                <div class="absolute inset-0 rounded-full overflow-hidden">
                  <img 
                    src={`https://picsum.photos/200/200?random=${Math.floor(Math.random() * 100)}`} 
                    alt={member.name} 
                    class="w-full h-full object-cover"
                  />
                </div>
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1">{member.name}</h3>
              <p class="text-indigo-600 dark:text-indigo-400 mb-3">{member.role}</p>
              <p class="text-gray-600 dark:text-gray-300">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <Testimonials locale="fa" />

  <!-- CTA Section -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-100 dark:border-gray-700">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">به ابتکار ملی ما بپیوندید</h2>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
            بخشی از تحول دیجیتال سلامت روان ایران با ذهنا باشید
          </p>
          <button class="bg-gradient-to-r from-primary to-secondary text-white font-bold px-8 py-4 rounded-xl hover:from-primary-dark hover:to-secondary-dark transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
            شروع کار با ذهنا
            <svg class="w-5 h-5 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>