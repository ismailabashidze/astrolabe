---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import AstroChart from '../components/AstroChart.astro';
import ZodiacSigns from '../components/ZodiacSigns.astro';
import Testimonials from '../components/Testimonials.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Statistics from '../components/Statistics.astro';
import { getTranslation, isRTL } from '../utils/i18n.js';
import { Image } from 'astro:assets';

// Import images directly
import heroImage from '.../../public/images/8.jpg';
import natalChartImage from '.../../public/images/1.jpg';
import transitsImage from '.../../public/images/6.jpg';
import synastryImage from '.../../public/images/4.jpg';
import progressionsImage from '.../../public/images/7.jpg';

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Sample chart data
const chartData = {
  planets: [
    { name: "Sun", position: "15° Leo", house: "5th" },
    { name: "Moon", position: "22° Scorpio", house: "8th" },
    { name: "Mercury", position: "8° Virgo", house: "6th" },
    { name: "Venus", position: "3° Leo", house: "5th" },
    { name: "Mars", position: "27° Cancer", house: "4th" }
  ]
};
---

<MainLayout title={t('welcome')} lang={lang} dir={dir}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-900 via-purple-900 to-indigo-800 text-white mb-20 shadow-2xl">
    <div class="absolute inset-0 bg-[url('/pattern.svg')] bg-repeat opacity-5"></div>
    <!-- Enhanced animated background elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden">
      <div class="absolute -top-40 -left-40 w-80 h-80 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
      <div class="absolute -bottom-40 -right-40 w-80 h-80 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-60 h-60 bg-pink-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-1000"></div>
    </div>
    <div class="relative container mx-auto px-4 lg:pl-12 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="text-center lg:text-left">
          <div class="flex items-center justify-center lg:justify-start mb-6">
            <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center mr-4 shadow-xl">
              <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-16 h-16" />
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-['Cinzel'] font-extrabold leading-tight tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-indigo-200 rtl:lg:text-right ltr:lg:text-left">
              {lang === "en" ? "Astrolabe" : t('welcome')}
            </h1>
          </div>
          <p class="text-xl md:text-2xl text-indigo-100 mb-6 max-w-2xl mx-auto lg:mx-0">
            {lang === "en" ? "Your open-source astrology tool for exploring the cosmos" : t('description')}
          </p>
          <p class="text-lg text-indigo-200 mb-10 max-w-2xl mx-auto lg:mx-0">
            Unlock the secrets of the universe with precise celestial calculations and ancient wisdom
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <button class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold px-8 py-4 rounded-xl hover:from-indigo-700 hover:to-purple-700 transition-all duration-300 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 relative overflow-hidden group">
              <span class="relative z-10">Get Started</span>
              <div class="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
            </button>
            <button class="bg-transparent border-2 border-white text-white font-bold px-8 py-4 rounded-xl hover:bg-white/10 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 relative overflow-hidden group">
              <span class="relative z-10">Learn More</span>
              <div class="absolute inset-0 bg-gradient-to-r from-white/10 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
            </button>
          </div>
        </div>
        <div class="flex justify-center">
          <div class="relative">
            <!-- Enhanced floating animation elements -->
            <div class="absolute -top-8 -left-8 w-40 h-40 bg-purple-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob"></div>
            <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-indigo-500 rounded-full mix-blend-multiply filter blur-2xl opacity-40 animate-blob animation-delay-2000"></div>
            <div class="relative rounded-3xl overflow-hidden border-8 border-white/20 shadow-2xl transform rotate-3 hover:rotate-0 transition-transform duration-700">
              <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/20 to-purple-500/20"></div>
              <Image 
                src={heroImage} 
                alt="Astrological Chart" 
                class="w-full h-auto object-cover relative z-10"
                width={600} 
                height={400}
                format="webp"
                loading="lazy"
              />
              <!-- Decorative elements -->
              <div class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-lg">
                <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-6 h-6" />
              </div>
              <!-- Floating elements -->
              <div class="absolute bottom-6 left-6 w-8 h-8 rounded-full bg-white/30 backdrop-blur-sm flex items-center justify-center animate-pulse shadow-lg">
                <div class="w-2 h-2 rounded-full bg-white"></div>
              </div>
              <div class="absolute top-1/3 left-1/4 w-6 h-6 rounded-full bg-purple-300/40 backdrop-blur-sm flex items-center justify-center animate-ping shadow-lg">
                <div class="w-1 h-1 rounded-full bg-white"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Decorative stars -->
    <div class="absolute top-10 left-10 w-2 h-2 rounded-full bg-white animate-pulse"></div>
    <div class="absolute top-20 right-20 w-1 h-1 rounded-full bg-white animate-pulse animation-delay-1000"></div>
    <div class="absolute bottom-20 left-1/3 w-1.5 h-1.5 rounded-full bg-white animate-pulse animation-delay-2000"></div>
    <div class="absolute bottom-10 right-10 w-2 h-2 rounded-full bg-white animate-pulse animation-delay-500"></div>
  </section>

  <!-- What is Astrolabe Section -->
  <section class="py-16 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-3xl mb-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center mb-6">
          <div class="w-16 h-16 rounded-full bg-white dark:bg-gray-800 flex items-center justify-center mr-4 shadow-lg">
            <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-12 h-12" />
          </div>
          <h2 class="text-3xl md:text-4xl font-['Cinzel'] font-bold text-gray-900 dark:text-white">What is Astrolabe?</h2>
        </div>
        <p class="text-xl text-gray-700 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
          Astrolabe is an open-source astrology platform that combines ancient wisdom with modern technology to provide accurate and insightful astrological interpretations.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Precision Calculations</h3>
            <p class="text-gray-600 dark:text-gray-400">
              We use the Swiss Ephemeris, the gold standard in astronomical calculations, to ensure the highest accuracy in all our astrological computations.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Open Source</h3>
            <p class="text-gray-600 dark:text-gray-400">
              As an open-source project, our code is transparent and community-driven, allowing for continuous improvement and peer review.
            </p>
          </div>
          
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700">
            <div class="w-12 h-12 rounded-full bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center mb-4 mx-auto">
              <svg class="w-6 h-6 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Community Focused</h3>
            <p class="text-gray-600 dark:text-gray-400">
              We're building a community of astrology enthusiasts, professionals, and developers working together to advance astrological understanding.
            </p>
          </div>
        </div>
        
        <div class="mt-12 bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700 max-w-3xl mx-auto">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Our Mission</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Astrolabe aims to make high-quality astrological tools accessible to everyone, regardless of their experience level. 
            We believe that understanding the cosmos can provide valuable insights into our personalities, relationships, and life paths.
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            By combining the precision of modern astronomy with the wisdom of traditional astrology, we create a bridge between 
            ancient knowledge and contemporary technology, empowering individuals to explore their celestial blueprint with confidence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Statistics Section -->
  <Statistics lang={lang} />

  <!-- Features Section -->
  <section class="mb-24">
    <div class="text-center mb-20">
      <div class="flex items-center justify-center mb-4">
        <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mr-3">
          <span class="text-3xl">🔮</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-['Cinzel'] font-bold text-gray-900">Powerful Astrological Insights</h2>
      </div>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-10">
        Discover the ancient wisdom of astrology with modern precision
      </p>
      <div class="w-24 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 mx-auto rounded-full"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 border border-gray-100 dark:border-gray-700 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-20 h-20 rounded-2xl bg-white dark:bg-gray-700 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
          <span class="text-3xl">🌟</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Natal Charts</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Detailed birth chart calculations with precise planetary positions
        </p>
        <div class="mt-4 rounded-xl overflow-hidden transform group-hover:scale-110 transition-transform duration-500">
          <Image 
            src={natalChartImage} 
            alt="Natal Chart" 
            class="w-full h-auto object-cover"
            width={300} 
            height={200}
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 border border-gray-100 dark:border-gray-700 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-20 h-20 rounded-2xl bg-white dark:bg-gray-700 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
          <span class="text-3xl">🌑</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Transits</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Track current planetary movements and their influences on your life
        </p>
        <div class="mt-4 rounded-xl overflow-hidden transform group-hover:scale-110 transition-transform duration-500">
          <Image 
            src={transitsImage} 
            alt="Transits" 
            class="w-full h-auto object-cover"
            width={300} 
            height={200}
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 border border-gray-100 dark:border-gray-700 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-20 h-20 rounded-2xl bg-white dark:bg-gray-700 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
          <span class="text-3xl">❤️</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Synastry</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Compare charts to understand relationships and compatibility
        </p>
        <div class="mt-4 rounded-xl overflow-hidden transform group-hover:scale-110 transition-transform duration-500">
          <Image 
            src={synastryImage} 
            alt="Synastry" 
            class="w-full h-auto object-cover"
            width={300} 
            height={200}
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 border border-gray-100 dark:border-gray-700 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group">
        <div class="w-20 h-20 rounded-2xl bg-white dark:bg-gray-700 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
          <span class="text-3xl">📈</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Progressions</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Explore your personal growth through secondary progressions
        </p>
        <div class="mt-4 rounded-xl overflow-hidden transform group-hover:scale-110 transition-transform duration-500">
          <Image 
            src={progressionsImage} 
            alt="Progressions" 
            class="w-full h-auto object-cover"
            width={300} 
            height={200}
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Sample Chart Section -->
  <section class="mb-20">
    <div class="text-center mb-12">
      <div class="flex items-center justify-center mb-4">
        <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center mr-3">
          <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-8 h-8" />
        </div>
        <h2 class="text-3xl md:text-4xl font-['Cinzel'] font-bold text-gray-900 dark:text-white">Sample Natal Chart</h2>
      </div>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Explore the comprehensive astrological analysis provided by Astrolabe
      </p>
      <div class="w-24 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 mx-auto rounded-full mt-6"></div>
    </div>
    
    <div class="max-w-6xl mx-auto bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700">
      <div class="px-6 py-5 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/30 dark:to-purple-900/30">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Natal Chart Analysis</h3>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="flex justify-center items-center min-h-[400px] bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 rounded-xl relative overflow-hidden">
            <!-- Decorative elements -->
            <div class="absolute inset-0 opacity-10 dark:opacity-5">
              <div class="absolute top-1/4 left-1/4 w-32 h-32 rounded-full bg-indigo-500"></div>
              <div class="absolute bottom-1/3 right-1/3 w-24 h-24 rounded-full bg-purple-500"></div>
              <div class="absolute top-1/3 right-1/4 w-16 h-16 rounded-full bg-pink-500"></div>
            </div>
            
            <!-- Chart visualization placeholder -->
            <div class="text-center z-10 relative">
              <div class="inline-flex items-center justify-center w-32 h-32 rounded-full bg-white dark:bg-gray-700 shadow-lg mb-6">
                <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center">
                  <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-12 h-12" />
                </div>
              </div>
              <h4 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Celestial Map</h4>
              <p class="text-gray-600 dark:text-gray-300 max-w-md">
                Your personalized natal chart based on birth date, time, and location
              </p>
            </div>
          </div>
          
          <div>
            <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Chart Details</h4>
            <div class="space-y-4">
              <div class="flex justify-between items-center pb-3 border-b border-gray-100 dark:border-gray-700">
                <span class="text-gray-600 dark:text-gray-300">Sun Sign</span>
                <span class="font-medium text-gray-900 dark:text-white">Leo ♌</span>
              </div>
              <div class="flex justify-between items-center pb-3 border-b border-gray-100 dark:border-gray-700">
                <span class="text-gray-600 dark:text-gray-300">Moon Sign</span>
                <span class="font-medium text-gray-900 dark:text-white">Scorpio ♏</span>
              </div>
              <div class="flex justify-between items-center pb-3 border-b border-gray-100 dark:border-gray-700">
                <span class="text-gray-600 dark:text-gray-300">Rising Sign (Ascendant)</span>
                <span class="font-medium text-gray-900 dark:text-white">Libra ♎</span>
              </div>
              <div class="flex justify-between items-center pb-3 border-b border-gray-100 dark:border-gray-700">
                <span class="text-gray-600 dark:text-gray-300">Mercury</span>
                <span class="font-medium text-gray-900 dark:text-white">Virgo ♍</span>
              </div>
              <div class="flex justify-between items-center pb-3 border-b border-gray-100 dark:border-gray-700">
                <span class="text-gray-600 dark:text-gray-300">Venus</span>
                <span class="font-medium text-gray-900 dark:text-white">Leo ♌</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-600 dark:text-gray-300">Mars</span>
                <span class="font-medium text-gray-900 dark:text-white">Cancer ♋</span>
              </div>
            </div>
            
            <div class="mt-8">
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Key Aspects</h4>
              <ul class="space-y-2">
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-gray-600 dark:text-gray-300">Sun in Leo trine Moon in Scorpio - Creative emotional expression</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-gray-600 dark:text-gray-300">Mercury in Virgo square Mars in Cancer - Analytical yet sensitive communication</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-gray-600 dark:text-gray-300">Venus in Leo conjunct Sun - Warm, generous affection</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="mt-8 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/30 dark:to-purple-900/30 rounded-xl p-6">
          <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Interpretation Summary</h4>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            This chart shows a person with a Leo Sun and Scorpio Moon, creating a fascinating blend of outward confidence and 
            deep emotional intensity. The Libra Ascendant adds a diplomatic, harmony-seeking veneer that mediates between these 
            powerful forces.
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            With Venus conjunct the Sun in Leo, this individual expresses affection generously and seeks admiration in relationships. 
            The Virgo Mercury suggests a precise, analytical mind, while Mars in Cancer indicates protective instincts and emotional 
            reactions to conflict.
          </p>
        </div>
      </div>
    </div>
    
    <div class="mt-12 text-center">
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        This detailed analysis is just a preview of what you'll receive with a full natal chart reading from Astrolabe. 
        Our comprehensive reports include interpretations for all planets, houses, aspects, and more.
      </p>
