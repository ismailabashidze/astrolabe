---
// src/pages/pricing.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';

const lang = "en";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);
---

<MainLayout title="Pricing - Zehna" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6">Intelligent Mental Health Solutions</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          A suite of AI-powered applications for mental wellness and better life. Choose the plan that works best for you.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Hamdel Plan -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-100 dark:border-gray-700">
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Hamdel</h2>
            <div class="mb-4">
              <span class="text-4xl font-bold text-gray-900 dark:text-white">$0</span>
              <span class="text-gray-600 dark:text-gray-300">/month</span>
            </div>
            <p class="text-gray-600 dark:text-gray-300">24/7 Emotional Support with AI</p>
          </div>
          
          <ul class="space-y-4 mb-8">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">24/7 AI-powered conversation based on Cognitive Behavioral Therapy (CBT)</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">Self-awareness exercises, mindful breathing, and guided meditation</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">Mood tracking, sleep quality, stress levels, and daily energy monitoring</span>
            </li>
            <li class="flex items-start opacity-50">
              <svg class="w-5 h-5 text-gray-400 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span class="text-gray-400 dark:text-gray-500">Sessions with professional psychologists (in paid plans)</span>
            </li>
            <li class="flex items-start opacity-50">
              <svg class="w-5 h-5 text-gray-400 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span class="text-gray-400 dark:text-gray-500">Personalized analysis of behavioral and emotional patterns</span>
            </li>
          </ul>
          
          <a href="https://panel.zehna.ir" class="w-full bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white font-medium py-3 px-4 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-200 inline-flex items-center justify-center">
            Get Started
          </a>
        </div>
        
        <!-- Hammasir Plan (Featured) -->
        <div class="bg-gradient-to-br from-[#3CAC88] to-[#99D2B4] rounded-2xl shadow-xl p-8 text-white relative transform scale-105">
          <div class="absolute top-0 right-0 bg-yellow-400 text-gray-900 text-xs font-bold px-4 py-1 rounded-bl-lg rounded-tr-2xl">
            MOST POPULAR
          </div>
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold mb-2">Hammasir</h2>
            <div class="mb-4">
              <span class="text-4xl font-bold">$9</span>
              <span class="text-indigo-100">/month</span>
            </div>
            <p class="text-indigo-100">Smart Marriage & Matchmaking Solution</p>
          </div>
          
          <ul class="space-y-4 mb-8">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-white mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Everything in Hamdel</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-white mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Advanced psychological assessment</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-white mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Life skills training for married couples</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-white mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Scientific matchmaking with advanced algorithms</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-white mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Couples counseling sessions with psychologists</span>
            </li>
          </ul>
          
          <a href="https://panel.zehna.ir" class="w-full bg-white text-indigo-600 font-medium py-3 px-4 rounded-lg hover:bg-indigo-50 transition-colors duration-200 shadow-lg inline-flex items-center justify-center">
            Start Free Trial
          </a>
        </div>
        
        <!-- TogetherMama Plan -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-100 dark:border-gray-700">
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">TogetherMama</h2>
            <div class="mb-4">
              <span class="text-4xl font-bold text-gray-900 dark:text-white">$19</span>
              <span class="text-gray-600 dark:text-gray-300">/month</span>
            </div>
            <p class="text-gray-600 dark:text-gray-300">Psychological Support for Mothers</p>
          </div>
          
          <ul class="space-y-4 mb-8">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">Everything in Hammasir</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">24/7 specialized support for mothers</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">Parenting education for children 0-12 years</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">Personalized parenting programs</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-900 dark:text-white">Digital growth tracking journal for children</span>
            </li>
          </ul>
          
          <a href="https://panel.zehna.ir" class="w-full bg-gradient-to-r from-[#3CAC88] to-[#99D2B4] text-white font-medium py-3 px-4 rounded-lg hover:from-[#3CAC88] hover:to-[#99D2B4] transition-all duration-200 shadow-md hover:shadow-lg inline-flex items-center justify-center">
            Start Free Trial
          </a>
        </div>
      </div>
      
      <div class="mt-16 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Other Specialized Solutions</h2>
        <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Darmana</h3>
            <p class="text-gray-600 dark:text-gray-300 text-sm">Psychological diagnosis based on global standards DSM-5 and PDM-2</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Kanape</h3>
            <p class="text-gray-600 dark:text-gray-300 text-sm">Role-play AI for learning psychotherapeutic skills through interactive scenarios</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Synapse</h3>
            <p class="text-gray-600 dark:text-gray-300 text-sm">AI for HR and organizational recruitment with psychological profiling</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Khebreh</h3>
            <p class="text-gray-600 dark:text-gray-300 text-sm">News analysis and social impact insights for understanding collective psychology</p>
          </div>
        </div>
  
        
        <div class="mt-12 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-700 dark:to-gray-800 rounded-2xl p-8 max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Custom Solution for Your Needs?</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            We can develop custom AI solutions for your organization, company, or specific requirements.
          </p>
          <button class="bg-gradient-to-r from-[#3CAC88] to-[#99D2B4] text-white font-medium py-3 px-6 rounded-lg hover:from-[#3CAC88] hover:to-[#99D2B4] transition-all duration-200 shadow-md hover:shadow-lg">
            Contact for Collaboration
          </button>
        </div>
      </div>
      
      <div class="mt-16 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Frequently Asked Questions</h2>
        <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Can I change plans later?</h3>
            <p class="text-gray-600 dark:text-gray-300">Yes, you can upgrade, downgrade, or cancel your subscription at any time.</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Do you offer refunds?</h3>
            <p class="text-gray-600 dark:text-gray-300">We offer a 30-day money-back guarantee for all paid plans.</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">Is there a free trial?</h3>
            <p class="text-gray-600 dark:text-gray-300">Yes, all paid plans come with a 14-day free trial.</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-100 dark:border-gray-700">
            <h3 class="font-bold text-gray-900 dark:text-white mb-2">How do I cancel my subscription?</h3>
            <p class="text-gray-600 dark:text-gray-300">You can cancel anytime from your account settings.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>