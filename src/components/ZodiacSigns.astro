---
// src/components/ZodiacSigns.astro
const signs = [
  { name: "Aries", symbol: "♈", element: "Fire", date: "Mar 21 - Apr 19" },
  { name: "Taurus", symbol: "♉", element: "Earth", date: "Apr 20 - May 20" },
  { name: "Gemini", symbol: "♊", element: "Air", date: "May 21 - Jun 20" },
  { name: "Cancer", symbol: "♋", element: "Water", date: "Jun 21 - Jul 22" },
  { name: "Leo", symbol: "♌", element: "Fire", date: "Jul 23 - Aug 22" },
  { name: "Virgo", symbol: "♍", element: "Earth", date: "Aug 23 - Sep 22" },
  { name: "Libra", symbol: "♎", element: "Air", date: "Sep 23 - Oct 22" },
  { name: "Scorpio", symbol: "♏", element: "Water", date: "Oct 23 - Nov 21" },
  { name: "Sagittarius", symbol: "♐", element: "Fire", date: "Nov 22 - Dec 21" },
  { name: "Capricorn", symbol: "♑", element: "Earth", date: "Dec 22 - Jan 19" },
  { name: "Aquarius", symbol: "♒", element: "Air", date: "Jan 20 - Feb 18" },
  { name: "Pisces", symbol: "♓", element: "Water", date: "Feb 19 - Mar 20" }
];

---

<section class="my-20">
  <div class="text-center mb-16">
    <div class="flex items-center justify-center mb-8">
      <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mr-3">
        <img src="/images/logo.svg" alt="Astrolabe Logo" class="w-12 h-12" />
      </div>
      <h2 class="text-3xl font-serif font-bold text-gray-900">Explore the Zodiac</h2>
    </div>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
      Discover the unique characteristics of each astrological sign
    </p>
  </div>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
    {signs.map((sign, index) => {
      // Assign colors based on element
      const elementColors = {
        Fire: "from-orange-400 to-red-500",
        Earth: "from-green-400 to-emerald-600",
        Air: "from-blue-400 to-indigo-600",
        Water: "from-cyan-400 to-blue-600"
      };
      
      const colorClass = elementColors[sign.element] || "from-gray-400 to-gray-600";
      
      return (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
          <div class={`bg-gradient-to-r ${colorClass} p-6 text-center`}>
            <div class="text-6xl text-white mb-4">{sign.symbol}</div>
            <h3 class="text-2xl font-bold text-white">{sign.name}</h3>
            <p class="text-white/90 font-medium">{sign.element}</p>
          </div>
          <div class="p-6">
            <p class="text-gray-600 text-center">{sign.date}</p>
            <button class="mt-4 w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-2 px-4 rounded-lg transition-colors duration-200">
              Learn More
            </button>
          </div>
        </div>
      );
    })}
  </div>
</section>