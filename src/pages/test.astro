---
// src/pages/test.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Test Page">
  <div class="p-4">
    <h1 class="text-3xl font-bold text-indigo-600 mb-4">Tailwind CSS Test</h1>
    <p class="text-lg text-gray-700 mb-4">If you can see styled text below, Tailwind is working correctly.</p>
    
    <div class="bg-white shadow rounded-lg p-6 max-w-md">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Styled Elements</h2>
      <ul class="space-y-2">
        <li class="flex items-center">
          <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
          <span class="text-gray-700">This should have a green dot</span>
        </li>
        <li class="flex items-center">
          <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
          <span class="text-gray-700">This should have a blue dot</span>
        </li>
        <li class="flex items-center">
          <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
          <span class="text-gray-700">This should have a red dot</span>
        </li>
      </ul>
      
      <button class="mt-4 bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700">
        This is a button
      </button>
    </div>
  </div>
</BaseLayout>