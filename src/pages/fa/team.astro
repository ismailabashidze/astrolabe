---
// src/pages/fa/team.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { getTranslation, isRTL } from '../../utils/i18n.js';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Team members data
const teamMembers = [
  {
    name: "دکتر الکس مورگان",
    role: "منجم ارشد",
    bio: "دکتری در منجمی با بیش از ۲۰ سال تجربه. در تفسیر جدول ناتال و منجمی روابط تخصص دارد.",
    image: "/images/team/elena.jpg",
    social: {
      twitter: "#",
      linkedin: "#"
    }
  },
  {
    name: "سام ریورا",
    role: "توسعه‌دهنده ارشد",
    bio: "مهندس سابق ناسا که به منجمی تبدیل شده است. دقت و صحت را به محاسبات نجومی ما می‌آورد.",
    image: "/images/team/michael.jpg",
    social: {
      twitter: "#",
      github: "#"
    }
  },
  {
    name: "جردن پاتل",
    role: "طراح UX",
    bio: "رابط‌های بصری ایجاد می‌کند که مفاهیم منجمی پیچیده را برای همه قابل دسترس می‌سازد.",
    image: "/images/team/sophia.jpg",
    social: {
      twitter: "#",
      dribbble: "#"
    }
  },
  {
    name: "تیلور کیم",
    role: "استراتژیست محتوا",
    bio: "نویسنده و معلم منجمی با اشتیاق به با relevance کردن حکمت باستانی با زندگی مدرن.",
    image: "/images/team/james.jpg",
    social: {
      twitter: "#",
      medium: "#"
    }
  },
  {
    name: "آمارا جانسون",
    role: "مدیر انجمن",
    bio: "جامعه پرشور ما از علاقه‌مندان و متخصصان منجمی را ایجاد و پرورش می‌دهد.",
    image: "/images/team/amara.jpg",
    social: {
      twitter: "#",
      instagram: "#"
    }
  },
  {
    name: "دیوید چن",
    role: "دانشمند داده",
    bio: "یادگیری ماشین را برای کشف الگوها در داده‌های منجمی و بهبود پیش‌بینی‌های ما به کار می‌برد.",
    image: "/images/team/david.jpg",
    social: {
      twitter: "#",
      linkedin: "#"
    }
  }
];
---

<MainLayout title="تیم ما - اسطرلاب" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6">تیم ما</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          متخصصان متعهدی که حکمت باستانی را با فناوری مدرن ترکیب می‌کنند تا بهترین ابزارهای منجمی را برای شما فراهم کنند
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
        {teamMembers.map((member, index) => (
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 card">
            <div class="card-content">
              <div class="relative mx-auto mb-6">
                <div class="w-24 h-24 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mx-auto">
                  <span class="text-2xl font-bold text-white">{member.avatar}</span>
                </div>
                <div class="absolute inset-0 rounded-full overflow-hidden">
                  <img 
                    src={`https://picsum.photos/200/200?random=${Math.floor(Math.random() * 100)}`} 
                    alt={member.name} 
                    class="w-full h-full object-cover opacity-0"
                  />
                </div>
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1 text-center">{member.name}</h3>
              <p class="text-indigo-600 dark:text-indigo-400 mb-3 text-center">{member.role}</p>
              <p class="text-gray-600 dark:text-gray-300 text-center">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 md:p-12 text-white">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">به ماموریت ما بپیوندید</h2>
          <p class="text-xl text-indigo-100 mb-8">
            همیشه به دنبال افراد متعهدی هستیم که به تیم ما بپیوندند. اگر چشمان ما را در مورد قابل دسترس کردن منجمی برای همه دارید، دوست داریم از شما بشنویم.
          </p>
          <button class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
            مشاهده موقعیت‌های شغلی
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>