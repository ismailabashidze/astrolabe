  <script is:inline>
    function faqAccordion() {
      return {
        openIndex: null,
        toggle(index) {
          if (this.openIndex === index) {
            this.openIndex = null;
          } else {
            this.openIndex = index;
          }
        }
      }
    }
  </script>

