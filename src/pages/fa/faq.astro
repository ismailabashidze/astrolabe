---
// src/pages/fa/faq.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { getTranslation, isRTL } from '../../utils/i18n.js';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// FAQ data in Persian
const faqCategories = [
  {
    category: "سؤالات عمومی",
    questions: [
      {
        question: "اسطرلاب چیست؟",
        answer: "اسطرلاب یک پلتفرم منجمی متن‌باز است که محاسبات و تفسیرهای دقیق منجمی را ارائه می‌دهد. ما ابزارهایی برای نمودارهای ناتال، گذرها، همبستگی، پیشرفت‌ها و موارد دیگر ارائه می‌دهیم که حکمت باستانی را با دقت مدرن ترکیب می‌کند."
      },
      {
        question: "آیا استفاده از اسطرلاب رایگان است؟",
        answer: "بله، اسطرلاب یک پلن پایه رایگان ارائه می‌دهد که شامل تولید نمودار نتال و تفسیرهای پایه است. ما همچنین پلن‌های حرفه‌ای و پریمیوم با ویژگی‌های بیشتر برای علاقه‌مندان و متخصصان جدی منجمی ارائه می‌دهیم."
      },
      {
        question: "محاسبات شما چقدر دقیق است؟",
        answer: "محاسبات ما از سوئیس افرمریس استفاده می‌کند که یکی از دقیق‌ترین الگوریتم‌های نجومی موجود است. ما پیش‌رونده، نوسان و سایر عوامل نجومی را برای ارائه موقعیت‌های دقیق سیاره‌ای در نظر می‌گیریم. برای دقیق‌ترین نمودار، توصیه می‌کنیم از زمان و مکان دقیق تولد خود استفاده کنید."
      }
    ]
  },
  {
    category: "پشتیبانی فنی",
    questions: [
      {
        question: "اسطرلاب از چه مرورگرهایی پشتیبانی می‌کند؟",
        answer: "اسطرلاب در تمام مرورگرهای مدرن از جمله Chrome، Firefox، Safari و Edge کار می‌کند. ما توصیه می‌کنیم از آخرین نسخه مرورگر مورد نظر خود برای بهترین تجربه استفاده کنید."
      },
      {
        question: "آیا می‌توانم از اسطرلاب روی دستگاه موبایلم استفاده کنم؟",
        answer: "بله، اسطرلاب کاملاً واکنش‌گرا است و در گوشی‌های هوشمند و تبلت‌ها عالی کار می‌کند. تجربه موبایل ما برای تعامل لمسی و صفحات کوچک‌تر بهینه‌سازی شده است."
      },
      {
        question: "چگونه می‌توانم یک اشکال یا مشکل فنی را گزارش کنم؟",
        answer: "می‌توانید اشکالات یا مشکلات فنی را از طریق صفحه تماس یا ایمیل support@astrolabe.example.com گزارش کنید. لطفاً جزئیات دستگاه، مرورگر و مراحل بازتولید مشکل را ارائه دهید."
      }
    ]
  },
  {
    category: "حساب و صورتحساب",
    questions: [
      {
        question: "چگونه می‌توانم یک حساب کاربری ایجاد کنم؟",
        answer: "می‌توانید با کلیک بر روی دکمه 'ثبت نام' در گوشه بالای سمت راست وب‌سایت ما، یک حساب کاربری ایجاد کنید. شما باید آدرس ایمیل خود را ارائه دهید و یک رمز عبور ایجاد کنید."
      },
      {
        question: "آیا می‌توانم اشتراک خود را تغییر دهم یا لغو کنم؟",
        answer: "بله، می‌توانید اشتراک خود را در هر زمان از تنظیمات حساب خود ارتقاء، کاهش یا لغو کنید. تغییرات بلافاصله اعمال می‌شوند و ما ضمانت بازپس‌گیری ۳۰ روزه برای تمام پلن‌های پولی ارائه می‌دهیم."
      },
      {
        question: "چه روش‌های پرداختی را می‌پذیرید؟",
        answer: "ما تمام کارت‌های اعتباری اصلی از جمله Visa، Mastercard و American Express را می‌پذیریم. ما همچنین از PayPal و انتقالات بانکی برای اشتراک‌های سالانه پشتیبانی می‌کنیم."
      }
    ]
  },
  {
    category: "سؤالات منجمی",
    questions: [
      {
        question: "نمودار نتال چیست؟",
        answer: "نمودار نتال، که به آن نمودار تولد نیز گفته می‌شود، نقشه‌ای از آسمان در لحظه و مکان دقیق تولد شماست. این نمودار موقعیت خورشید، ماه و سیارات را در نشانه‌ها و خانه‌های زودیاک نشان می‌دهد که منجمان از آن برای درک شخصیت، نقاط قوت، چالش‌ها و مسیر زندگی شما استفاده می‌کنند."
      },
      {
        question: "دقت زمان تولد چقدر مهم است؟",
        answer: "دقت زمان تولد برای محاسبات دقیق نمودار، به‌ویژه برای صعود، نشانه ماه و قرارگیری خانه‌ها بسیار مهم است. حتی چند دقیقه می‌تواند تفاوت ایجاد کند. اگر زمان دقیق تولد خود را نمی‌دانید، می‌توانیم به شما کمک کنیم با استفاده از رویدادهای مهم زندگی آن را اصلاح کنیم."
      },
      {
        question: "آیا مشاوره منجمی ارائه می‌دهید؟",
        answer: "اگرچه ما مستقیماً مشاوره ارائه نمی‌دهیم، پلتفرم ما تفسیرهای دقیقی ارائه می‌دهد که بسیاری از منجمان حرفه‌ای به عنوان پایه‌ای برای خواندن‌های خود استفاده می‌کنند. ما همچنین جامعه‌ای از متخصصان داریم که مشاوره ارائه می‌دهند."
      }
    ]
  }
];
---

<MainLayout title="سؤالات متداول - اسطرلاب" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-4">سؤالات متداول</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          پاسخ‌هایی برای سؤالات رایج درباره اسطرلاب و منجمی پیدا کنید
        </p>
      </div>
      
      <div x-data="faqAccordion()" class="max-w-4xl mx-auto">
        <template x-for="(category, catIndex) in faqCategories" :key="catIndex">
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700" x-text="category.category"></h2>
            <div class="space-y-6">
              <template x-for="(faq, index) in category.questions" :key="index">
                <div class="bg-white dark:bg-gray-700 rounded-xl shadow-md border border-gray-100 dark:border-gray-600 overflow-hidden">
                  <div @click="toggle(catIndex + '_' + index)" class="faq-question flex justify-between items-center p-6 cursor-pointer">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white" x-text="faq.question"></h3>
                    <svg class="w-5 h-5 text-gray-500 dark:text-gray-300 transform transition-transform duration-200" :class="{ 'rotate-180': openIndex === catIndex + '_' + index }" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <div x-show="openIndex === catIndex + '_' + index" x-transition class="faq-answer px-6 pb-6">
                    <p class="text-gray-600 dark:text-gray-200" x-text="faq.answer"></p>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
      
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 md:p-12 text-white mt-16">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">هنوز سؤال دارید؟</h2>
          <p class="text-xl text-indigo-100 mb-8">
            نمی‌توانید پاسخ مورد نظر خود را پیدا کنید؟ تیم پشتیبانی ما اینجاست تا کمک کند.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/fa/contact" class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
              تماس با پشتیبانی
            </a>
            <a href="/fa/community" class="bg-transparent border-2 border-white text-white font-medium px-8 py-3 rounded-lg hover:bg-white/10 transition-colors duration-300">
              پیوستن به جامعه
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <script is:inline>
    function faqAccordion() {
      return {
        openIndex: null,
        toggle(index) {
          if (this.openIndex === index) {
            this.openIndex = null;
          } else {
            this.openIndex = index;
          }
        },
        faqCategories: [
