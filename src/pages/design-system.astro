---
// src/pages/design-system.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Design System - Astrolabe" lang="en" dir="ltr">
  <section class="text-center mb-16">
    <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">Design System</h1>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
      Astrolabe's design system documentation with updated visual language
    </p>
  </section>
  
  <!-- Color Palette -->
  <section class="card mb-12">
    <div class="card-header">
      <h2 class="text-2xl font-bold text-gray-900">Color Palette</h2>
    </div>
    <div class="card-content">
      <div class="space-y-12">
        <div>
          <h3 class="text-xl font-semibold mb-6 text-gray-900">Brand Colors</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-xl p-6 text-white">
              <div class="text-4xl mb-3">A</div>
              <h4 class="text-lg font-bold mb-1">Indigo</h4>
              <p class="text-indigo-100">#6366f1</p>
            </div>
            <div class="bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl p-6 text-white">
              <div class="text-4xl mb-3">A</div>
              <h4 class="text-lg font-bold mb-1">Purple</h4>
              <p class="text-purple-100">#8b5cf6</p>
            </div>
            <div class="bg-gradient-to-br from-pink-500 to-pink-700 rounded-xl p-6 text-white">
              <div class="text-4xl mb-3">A</div>
              <h4 class="text-lg font-bold mb-1">Pink</h4>
              <p class="text-pink-100">#ec4899</p>
            </div>
          </div>
        </div>
        
        <div>
          <h3 class="text-xl font-semibold mb-6 text-gray-900">Element Colors</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-gradient-to-br from-orange-400 to-red-500 rounded-lg p-4 text-white text-center">
              <div class="text-3xl mb-2">♈</div>
              <h4 class="font-bold">Fire</h4>
            </div>
            <div class="bg-gradient-to-br from-green-400 to-emerald-600 rounded-lg p-4 text-white text-center">
              <div class="text-3xl mb-2">♉</div>
              <h4 class="font-bold">Earth</h4>
            </div>
            <div class="bg-gradient-to-br from-blue-400 to-indigo-600 rounded-lg p-4 text-white text-center">
              <div class="text-3xl mb-2">♊</div>
              <h4 class="font-bold">Air</h4>
            </div>
            <div class="bg-gradient-to-br from-cyan-400 to-blue-600 rounded-lg p-4 text-white text-center">
              <div class="text-3xl mb-2">♋</div>
              <h4 class="font-bold">Water</h4>
            </div>
          </div>
        </div>
        
        <div>
          <h3 class="text-xl font-semibold mb-6 text-gray-900">Neutral Colors</h3>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 rounded-lg bg-white border border-gray-200 mb-2"></div>
              <div class="text-center">
                <div class="font-medium text-gray-900">White</div>
                <div class="text-xs text-gray-500">#ffffff</div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 rounded-lg bg-gray-50 border border-gray-200 mb-2"></div>
              <div class="text-center">
                <div class="font-medium text-gray-900">Gray 50</div>
                <div class="text-xs text-gray-500">#f8fafc</div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 rounded-lg bg-gray-100 border border-gray-200 mb-2"></div>
              <div class="text-center">
                <div class="font-medium text-gray-900">Gray 100</div>
                <div class="text-xs text-gray-500">#f1f5f9</div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 rounded-lg bg-gray-900 mb-2"></div>
              <div class="text-center">
                <div class="font-medium text-white">Gray 900</div>
                <div class="text-xs text-gray-500">#1e293b</div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 rounded-lg bg-gray-500 mb-2"></div>
              <div class="text-center">
                <div class="font-medium text-white">Gray 500</div>
                <div class="text-xs text-gray-500">#64748b</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Typography -->
  <section class="card mb-12">
    <div class="card-header">
      <h2 class="text-2xl font-bold text-gray-900">Typography</h2>
    </div>
    <div class="card-content">
      <div class="space-y-6">
        <div>
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-2">Heading 1 - Playfair Display</h1>
          <p class="text-gray-500">48px / 56px, Bold</p>
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-2">Heading 2 - Playfair Display</h2>
          <p class="text-gray-500">36px / 44px, Bold</p>
        </div>
        <div>
          <h3 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 mb-2">Heading 3 - Playfair Display</h3>
          <p class="text-gray-500">30px / 38px, Bold</p>
        </div>
        <div>
          <h4 class="text-xl md:text-2xl font-serif font-bold text-gray-900 mb-2">Heading 4 - Playfair Display</h4>
          <p class="text-gray-500">24px / 32px, Bold</p>
        </div>
        <div>
          <h5 class="text-lg md:text-xl font-medium text-gray-900 mb-2">Heading 5 - Inter</h5>
          <p class="text-gray-500">20px / 28px, Medium</p>
        </div>
        <div>
          <h6 class="text-base md:text-lg font-medium text-gray-900 mb-2">Heading 6 - Inter</h6>
          <p class="text-gray-500">16px / 24px, Medium</p>
        </div>
        <div>
          <p class="text-base text-gray-800 mb-2">Body text - Inter. This is a paragraph with regular body text. It demonstrates the base font size and line height used throughout the application.</p>
          <p class="text-gray-500">16px / 24px, Regular</p>
        </div>
        <div>
          <p class="text-sm text-gray-800">Small text - Inter. This is smaller text used for captions, footnotes, and other secondary information.</p>
          <p class="text-gray-500">14px / 20px, Regular</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Buttons -->
  <section class="card mb-12">
    <div class="card-header">
      <h2 class="text-2xl font-bold text-gray-900">Buttons</h2>
    </div>
    <div class="card-content">
      <div class="flex flex-wrap gap-4">
        <button class="btn-primary">
          Primary Button
        </button>
        <button class="btn-secondary">
          Secondary Button
        </button>
        <button class="btn-outline">
          Outline Button
        </button>
        <button class="btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 focus:ring-gray-500">
          Secondary Outline
        </button>
      </div>
    </div>
  </section>
  
  <!-- Cards -->
  <section class="card mb-12">
    <div class="card-header">
      <h2 class="text-2xl font-bold text-gray-900">Cards</h2>
    </div>
    <div class="card-content">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card">
          <div class="card-header">
            <h3 class="text-xl font-bold text-gray-900">Sample Card</h3>
          </div>
          <div class="card-content">
            <p class="text-gray-700 mb-4">This is a sample card component with a header and content section.</p>
            <button class="btn-primary">Action</button>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl shadow-lg text-white overflow-hidden">
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">Gradient Card</h3>
            <p class="text-indigo-100 mb-4">This is a card with a gradient background.</p>
            <button class="bg-white text-indigo-900 font-medium px-4 py-2 rounded-lg hover:bg-indigo-50 transition-colors duration-200">
              Action
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Form Elements -->
  <section class="card">
    <div class="card-header">
      <h2 class="text-2xl font-bold text-gray-900">Form Elements</h2>
    </div>
    <div class="card-content">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="form-label">Text Input</label>
          <input type="text" class="form-input" placeholder="Enter text">
        </div>
        
        <div>
          <label class="form-label">Select Input</label>
          <select class="form-input">
            <option>Option 1</option>
            <option>Option 2</option>
            <option>Option 3</option>
          </select>
        </div>
        
        <div class="md:col-span-2">
          <label class="form-label">Textarea</label>
          <textarea class="form-input" rows="4" placeholder="Enter your message"></textarea>
        </div>
      </div>
    </div>
  </section>
</MainLayout>