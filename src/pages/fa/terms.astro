---
// src/pages/fa/terms.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);
---

<MainLayout title={t('termsTitle')} lang={lang} dir={dir}>
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 pattern-bg"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">{t('termsTitle')}</h1>
        <p class="text-xl md:text-2xl text-gray-700 max-w-2xl mx-auto">
          آخرین به‌روزرسانی: ۲۷ اوت ۲۰۲۵
        </p>
      </div>
    </div>
  </section>

  <!-- Terms Content -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="card">
          <div class="card-content">
            <div class="prose prose-lg max-w-none">
              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۱. پذیرش شرایط</h2>
              <p class="text-gray-700 mb-6">
                با دسترسی یا استفاده از ذهنا، شما موافقت می‌کنید که به این شرایط خدمات و تمام قوانین و مقررات قابل اجرا ملتزم خواهید بود. اگر با هر یک از این شرایط موافق نیستید، استفاده یا دسترسی به این سایت برای شما ممنوع است.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۲. مجوز استفاده</h2>
              <p class="text-gray-700 mb-4">
                اجازه دانلود موقت یک نسخه از مواد (اطلاعات یا نرم‌افزار) در ذهنا برای مشاهده موقت شخصی و غیرتجاری داده شده است. این یک اعطا مجوز است، نه انتقال مالکیت، و تحت این مجوز شما نمی‌توانید:
              </p>
              <ul class="list-disc pr-8 mb-6 text-gray-700" dir="rtl">
                <li>مواد را اصلاح یا کپی کنید</li>
                <li>از مواد برای هر منظور تجاری استفاده کنید</li>
                <li>تلاش کنید نرم‌افزارهای موجود در ذهنا را تجزیه یا مهندسی معکوس کنید</li>
                <li>هرگونه نشانه‌گذاری حق نشر یا مالکیت دیگر را از مواد حذف کنید</li>
              </ul>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۳. سلب مسئولیت</h2>
              <p class="text-gray-700 mb-6">
                مواد در ذهنا به صورت "همانطور که هست" ارائه می‌شوند. ذهنا هیچ گونه ضمانتی، صریح یا ضمنی، نمی‌دهد و اینجا سلب مسئولیت و رد تمام ضمانت‌های دیگر از جمله، بدون محدودیت، ضمانت‌های ضمنی یا شرایط قابل فروش بودن، تناسب برای یک هدف خاص، یا عدم نقض مالکیت فکری یا سایر تخلفات از حقوق را اعلام می‌کند.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۴. محدودیت‌ها</h2>
              <p class="text-gray-700 mb-6">
                در هیچ شرایطی ذهنا یا تأمین‌کنندگان آن مسئول هیچ گونه خسارات (از جمله، بدون محدودیت، خسارات به دلیل از دست دادن داده‌ها یا سود، یا به دلیل قطع فعالیت تجاری) ناشی از استفاده یا عدم توانایی در استفاده از مواد در ذهنا نخواهند بود، حتی اگر ذهنا یا یک نماینده مجاز به صورت شفاهی یا کتبی از احتمال وقوع چنین خساراتی مطلع شده باشد.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۵. دقت مواد</h2>
              <p class="text-gray-700 mb-6">
                مواد موجود در ذهنا ممکن است شامل خطاهای فنی، تایپوگرافی یا عکاسی باشد. ذهنا ضمانت نمی‌کند که هیچ یک از مواد در وب‌سایت آن دقیق، کامل یا به‌روز باشد. ذهنا ممکن است در هر زمان بدون اطلاع قبلی تغییراتی در مواد موجود در وب‌سایت خود ایجاد کند.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۶. پیوندها</h2>
              <p class="text-gray-700 mb-6">
                ذهنا همه سایت‌های پیوند داده شده به وب‌سایت خود را بررسی نکرده و مسئول محتوای هیچ یک از این سایت‌های پیوند داده شده نیست. گنجاندن هر پیوند به معنای تأیید ذهنا از آن سایت نیست. استفاده از هر وب‌سایت پیوند داده شده با ریسک خود کاربر است.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۷. اصلاحات</h2>
              <p class="text-gray-700 mb-6">
                ذهنا ممکن است این شرایط خدمات وب‌سایت خود را در هر زمان بدون اطلاع قبلی اصلاح کند. با استفاده از این وب‌سایت شما موافقت می‌کنید که به نسخه فعلی این شرایط خدمات ملتزم خواهید بود.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۸. قانون حاکم</h2>
              <p class="text-gray-700 mb-6">
                این شرایط و ضوابط تابع قوانین حاکمیت و تفسیر مطابق با قوانین قضایی محل فعالیت ذهنا هستند و شما به طور جبران‌ناپذیری تحت حکومت منحصربه‌فرد دادگاه‌های آن محل قرار می‌گیرید.
              </p>

              <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">۹. سلب مسئولیت منجمی</h2>
              <p class="text-gray-700 mb-6">
                ذهنا اطلاعات منجمی را فقط برای اهداف سرگرمی ارائه می‌دهد. اطلاعات ارائه شده به جایگزین مشاوره، تشخیص یا درمان حرفه‌ای منجمی نیست. همیشه از مشاوره یک منجم واجد شرایط در مورد هر سؤالی که در مورد جدول یا تفسیرات منجمی خود دارید استفاده کنید.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>