---
// src/pages/fa/team.astro
import MainLayout from '@layouts/MainLayout.astro';
import { getTranslation, isRTL } from '@utils/i18n.js';

const lang = "fa";
const dir = isRTL(lang) ? "rtl" : "ltr";
const t = (key) => getTranslation(lang, key);

// Team members data - Zehna Platform Team
const teamMembers = [
  {
    name: "دکتر هادی بهرامی احسان",
    role: "بنیان‌گذار و دانشمند ارشد",
    bio: "استاد تمام دانشگاه تهران. متخصص در ترکیب هوش مصنوعی با علوم روانشناختی برای ایجاد راهکارهای دسترسی‌پذیر سلامت روان.",
    image: "/images/team/hadi.jpg",
    social: {
      linkedin: "https://www.linkedin.com/",
      medium: "#"
    }
  },
  {
    name: "علی بهرامی احسان",
    role: "رهبر تحقیقات هوش مصنوعی",
    bio: "دانشمند داده با تجربه در یادگیری ماشین و پردازش زبان طبیعی. هدایت توسعه مدل‌های هوش مصنوعی برای پشتیبانی از سلامت روان.",
    image: "/images/team/alex.jpg",
    social: {
      twitter: "#",
      github: "#",
      linkedin: "#"
    }
  },
  {
    name: "حسین نوروزی",
    role: "توسعه‌دهنده ارشد",
    bio: "مهندس نرم‌افزار با تخصص در توسعه پلتفرم‌های مقیاس‌پذیر. مسئول زیرساخت فنی و یکپارچه‌سازی هوش مصنوعی در ذهنا.",
    image: "/images/team/sam.jpg",
    social: {
      twitter: "#",
      github: "#"
    }
  },
  {
    name: "مهدیه یوسفی",
    role: "روانشناس ارشد",
    bio: "روانشناس و عضو علمی ",
    image: "/images/team/jordan.jpg",
    social: {
      twitter: "#",
      dribbble: "#"
    }
  },
  {
    name: "مصطفی الوندیان",
    role: "متخصص تحقیق و توسعه",
    bio: "فارغ التحصیل دکتری برق مخابرات. تحقیق و توسعه الگوریتم‌های پیشرفته برای بهبود قابلیت‌های هوش مصنوعی ذهنا.",
    image: "/images/team/taylor.jpg",
    social: {
      twitter: "#",
      medium: "#"
    }
  },
];
---

<MainLayout title="تیم ما - ذهنا" lang={lang} dir={dir}>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6">تیم ما</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          متخصصان متعهدی که علوم روانشناختی را با فناوری مدرن ترکیب می‌کنند تا بهترین ابزارهای سلامت روان را برای شما فراهم کنند
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
        {teamMembers.map((member, index) => (
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-xl transition-all duration-300 card">
            <div class="card-content">
              <div class="relative mx-auto mb-6">
                <div class="w-24 h-24 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center mx-auto">
                  <span class="text-2xl font-bold text-white">{member.name.charAt(0)}</span>
                </div>
                <div class="absolute inset-0 rounded-full overflow-hidden">
                  <img 
                    src={`https://picsum.photos/200/200?random=${Math.floor(Math.random() * 100)}`} 
                    alt={member.name} 
                    class="w-full h-full object-cover opacity-0"
                  />
                </div>
              </div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1 text-center">{member.name}</h3>
              <p class="text-indigo-600 dark:text-indigo-400 mb-3 text-center">{member.role}</p>
              <p class="text-gray-600 dark:text-gray-300 text-center">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-8 md:p-12 text-white">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">به ماموریت ما بپیوندید</h2>
          <p class="text-xl text-indigo-100 mb-8">
            همیشه به دنبال افراد متعهدی هستیم که به تیم ما بپیوندند. اگر چشمان ما را در مورد دسترسی‌پذیر کردن سلامت روان برای همه دارید، دوست داریم از شما بشنویم.
          </p>
          <button class="bg-white text-indigo-900 font-medium px-8 py-3 rounded-lg hover:bg-indigo-50 transition-colors duration-300 shadow-lg">
            مشاهده موقعیت‌های شغلی
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>